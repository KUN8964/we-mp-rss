scription":"Send a reply to a WeCom (企业微信) user. For text: pass text (markdown supported)."}],"applicationName":"WorkBuddy","dataFolderName":".workbuddy","darwinBundleIdentifier":"com.workbuddy.workbuddy","win32x64AppId":"{61A882F2-969F-45BF-A652-FA5C6B03DE22}","win32arm64AppId":"{E5979B74-105C-46B5-AED6-599C029B689D}","win32x64UserAppId":"{BFD312E9-1019-4F57-9F44-F86246833B50}","win32arm64UserAppId":"{B7353D0F-D01C-4EC3-96A9-5CEA88358454}","win32MutexName":"workbuddy","win32AppUserModelId":"WorkBuddy.WorkBuddy","deepLinkSchemes":["workbuddy"],"galileo":{"enable":true,"patchName":"workbuddy","processPerformanceIntervalMin":5,"networkIntervalMin":5,"aggregatorFlushIntervalSec":15},"log":{"upload":{"enabled":true,"interval":120,"allowedEnvironments":["iOA"]}},"commit":"d063704609ddf7c6906f295e675bf339e82aa373","date":"2026-06-18T13:17:09.699Z","genieVersion":"5.1.4","builtInMarketPlugins":[{"autoEnable":true,"marketplaceName":"cb_teams_marketplace","name":"document-skills","scope":"user"},{"autoEnable":true,"marketplaceName":"codebuddy-plugins-official","name":"agent-browser","scope":"user"},{"autoEnable":true,"marketplaceName":"codebuddy-plugins-official","name":"playwright-cli","scope":"user"},{"autoEnable":true,"marketplaceName":"cb_teams_marketplace","name":"finance-data","scope":"user"},{"autoEnable":true,"marketplaceName":"codebuddy-plugins-official","name":"find-skills","scope":"user"}],"builtInSkillMarketplaces":{"codebuddy-skill-official":{"source":"zip","url":"https://download.codebuddy.cn/skill-marketplace/skill-marketplace-66396a74-7070-456a-8be0-f05ae0cbb466.zip"}},"integrations":{"builtins":{"anydev":false,"cloudStudio":true,"eop":true,"lighthouse":true,"supabase":true,"tcb":true}},"productFeatureExperiment":{"enabled":true,"pollingEnabled":false},"networkEnvironment":"internal"}
