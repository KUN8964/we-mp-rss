[SQL] SELECT filter_rules.id AS filter_rules_id, filter_rules.mp_id AS filter_rules_mp_id, filter_rules.rule_name AS filter_rules_rule_name, filter_rules.remove_ids AS filter_rules_remove_ids, filter_rules.remove_classes AS filter_rules_remove_classes, filter_rules.remove_selectors AS filter_rules_remove_selectors, filter_rules.remove_attributes AS filter_rules_remove_attributes, filter_rules.remove_regex AS filter_rules_remove_regex, filter_rules.remove_normal_tag AS filter_rules_remove_normal_tag, filter_rules.status AS filter_rules_status, filter_rules.priority AS filter_rules_priority, filter_rules.created_at AS filter_rules_created_at, filter_rules.updated_at AS filter_rules_updated_at 
FROM filter_rules 
WHERE filter_rules.status = ? ORDER BY filter_rules.priority DESC
[参数] (1,)
[FilterRule] 查询到 0 条启用的规则
