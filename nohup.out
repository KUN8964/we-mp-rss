ass="rich_media" id="js_article" style="position:relative;">\n   <div class="top_banner" id="js_top_ad_area">\n   </div>\n   <div class="rich_media_inner" id="js_base_container">\n    <div class="wx_row_immersive_stream_wrap" id="js_row_immersive_stream_wrap">\n     <div id="js_row_immersive_cover_img">\n      <img src="https://mmbiz.qpic.cn/mmbiz_jpg/hmkxKic9qKJE0v58sD4slZDD08wDiarXXbWFCIR323KpNyFz0jvzwLqNI7OlnsADh3WjQtRzuia51icwaqIpqN1MgdAYbKkwibMMORrxUhA6ufHw/0?wx_fmt=jpeg"/>\n     </div>\n     <div class="wx_row_immersive_stream_mask" id="js_row_immersive_stream_mask">\n     </div>\n    </div>\n    <div class="rich_media_area_primary" id="page-content">\n     <div class="rich_media_area_primary_inner">\n      <div class="rich_media_wrp" id="img-content">\n       <h1 class="rich_media_title" id="activity-name">\n        <span>\n         【巫师】2026春晚背后的资本博弈\n        </span>\n       </h1>\n       <div class="rich_media_meta_list" id="meta_content">\n        <span>\n         原创\n        </span>\n        <span>\n         <span>\n          巫师财经\n         </span>\n         <span style="display: none;">\n          巫师财经\n         </span>\n        </span>\n        <span>\n         <a class="wx_tap_link js_wx_tap_highlight weui-wa-hotarea" href="javascript:void(0);" id="js_name">\n          巫师财经\n         </a>\n         <div id="js_profile_card">\n         </div>\n        </span>\n        <span>\n         <em class="rich_media_meta rich_media_meta_text" id="publish_time">\n         </em>\n         <em class="rich_media_meta rich_media_meta_text" id="js_ip_wording_wrp" style="display: none;">\n          <span>\n          </span>\n          <span>\n          </span>\n         </em>\n         <em aria-labelledby="js_a11y_op_title_modify js_title_modify" class="rich_media_meta rich_media_meta_text" id="js_title_modify_wrp" role="option" style="display: none;">\n          <span>\n          </span>\n         </em>\n         <span style="display: none;">\n         </span>\n        </span>\n       </div>\n       <div class="novel-card js_wx_tap_highlight wx_tap_card" id="js_novel_card" style="display: none;">\n        <div class="novel-card__left novel-card__new-only">\n         <div class="novel-card__cover" id="js_novel_cover">\n          <img/>\n         </div>\n         <div class="novel-card__text">\n          <div class="novel-card__main" id="js_novel_title">\n           在小说阅读器读本章\n          </div>\n          <div class="novel-card__subtitle" id="js_novel_subtitle">\n          </div>\n         </div>\n        </div>\n        <div class="novel-card__link novel-card__new-only" id="js_novel_link">\n         去阅读\n        </div>\n        <div class="novel-info novel-card__old-only">\n         <div class="novel-cover-group">\n          <div class="novel-cover" id="js_novel_cover_old">\n           <img/>\n          </div>\n          <div class="novel-meta">\n           <div class="novel-title" id="js_novel_title_old">\n           </div>\n           <div class="novel-description">\n            在小说阅读器中沉浸阅读\n           </div>\n          </div>\n         </div>\n        </div>\n        <div class="arrow-jump-icon novel-card__old-only">\n        </div>\n       </div>\n       <div class="rich_media_content js_underline_content autoTypeSetting24psection" id="js_content" style="visibility: hidden; opacity: 0; ">\n        <section powered-by="werss">\n         <span style="font-size: 14.6667px;">\n          <span>\n           <span style="color: rgb(0, 0, 0);">\n            6000万人看过春晚背后的资本暗斗，第二季来了\n           </span>\n          </span>\n         </span>\n        </section>\n        <section powered-by="werss">\n         <span style="font-size: 14.6667px;">\n          <section powered-by="werss" style="display: inline-block;text-indent: 0px;">\n           <img src="https://mmbiz.qpic.cn/sz_mmbiz_jpg/hmkxKic9qKJGDTWYvZKD7VmwV8sO3Fjicp5srfAnGyptcjhxYY1OCicV63sVsVMrzS0ib9VWrm7CQZml3AJtbqTTqtLK5XxsIhV3wBibibxOyv7gI/640?wx_fmt=other&amp;from=appmsg" style="left:0px;top:0px;width:100%;background-color:transparent;"/>\n          </section>\n         </span>\n        </section>\n        <section powered-by="werss">\n         <span style="font-size: 14.6667px;">\n          <span>\n           <span style="color: rgb(0, 0, 0);">\n            每年春晚都会引爆一个企业。相关品牌和估值飞升\n           </span>\n          </span>\n         </span>\n        </section>\n        <section powered-by="werss">\n         <span style="font-size: 14.6667px;">\n          <span>\n           <span style="color: rgb(0, 0, 0);">\n            先压个注，2026年，你们觉得哪个企业，是今年的\n           </span>\n          </span>\n         </span>\n         <span style="font-size: 14.6667px;">\n          <span>\n           <span style="color: rgb(0, 0, 0);">\n           </span>\n          </span>\n         </span>\n         <span style="font-size: 14.6667px;">\n          <span>\n           <span style="color: rgb(0, 0, 0);">\n            【\n           </span>\n          </span>\n         </span>\n         <span style="color: rgb(255, 0, 0);font-size: 14.6667px;">\n          <span>\n           <span style="color: rgb(0, 0, 0);">\n            赚钱效应\n           </span>\n          </span>\n         </span>\n         <span style="font-size: 14.6667px;">\n          <span>\n           <span style="color: rgb(0, 0, 0);">\n            】之王\n           </span>\n          </span>\n         </span>\n        </section>\n        <section powered-by="werss">\n         <span style="font-size: 21.3333px;">\n          <span>\n           <span style="color: rgb(0, 0, 0);font-weight: bold;">\n            机器人\n           </span>\n          </span>\n         </span>\n        </section>\n        <section powered-by="werss">\n         <span style="font-size: 14.6667px;">\n          <span>\n           <span style="color: rgb(0, 0, 0);">\n            首先登场的是——机器人，2025春晚【赚钱效应】之王就是穿着花袄的宇树机器人，随后一年其中标公告飙升至92个，是24年的2.4倍，而且由于宇树自己还没上市。股市中资金疯狂涌入其供应链企业，股价集体起飞\n           </span>\n          </span>\n         </span>\n        </section>\n        <section powered-by="werss">\n         <span style="font-size: 14.6667px;">\n          <section powered-by="werss" style="display: inline-block;text-indent: 0px;">\n           <img src="https://mmbiz.qpic.cn/mmbiz_jpg/hmkxKic9qKJFKy7PPXJ2dp284w8UT2z6HRDZfm8QEKTj8eOaJYwPrG9IetQKpcs3ibF1OJjZ0yCNVCcLicNYdlR6iarmDtJthQRn9Q0iaItBC1Ag/640?wx_fmt=other&amp;from=appmsg" style="left:0px;top:0px;width:100%;background-color:transparent;"/>\n          </section>\n         </span>\n        </section>\n        <section powered-by="werss">\n         <span style="font-size: 14.6667px;">\n          <span>\n           <span style="color: rgb(0, 0, 0);">\n            去年的示范效应下，今年机器人企业在春晚的资本博弈再次加码\n           </span>\n          </span>\n         </span>\n        </section>\n        <section powered-by="werss">\n         <span style="font-size: 14.6667px;">\n          <span>\n           <span style="color: rgb(0, 0, 0);">\n            三个月前，根据多家科技媒体披露，2026春晚的机器人竞标主要集中在\n           </span>\n          </span>\n         </span>\n         <span style="color: rgb(255, 0, 0);font-size: 14.6667px;">\n          <span>\n           <span style="color: rgb(0, 0, 0);">\n            宇树和智元\n           </span>\n          </span>\n         </span>\n         <span style="font-size: 14.6667px;">\n          <span>\n           <span style="color: rgb(0, 0, 0);">\n            ，两位玩家身上，后者智元就是那个华为天才少年彭志辉联合创立的公司\n           </span>\n          </span>\n         </span>\n        </section>\n        <section powered-by="werss">\n         <span style="font-size: 14.6667px;">\n          <span>\n           <span style="color: rgb(0, 0, 0);">\n            传闻智元开出了\n           </span>\n          </span>\n         </span>\n         <span style="color: rgb(255, 0, 0);font-size: 14.6667px;">\n          <span>\n           <span style="color: rgb(0, 0, 0);">\n            6000万元\n           </span>\n          </span>\n         </span>\n         <span style="font-size: 14.6667px;">\n          <span>\n           <span style="color: rgb(0, 0, 0);">\n            的价码，试图拿下独家春晚权益，而宇树直接将投标金额抬升至\n           </span>\n          </span>\n         </span>\n         <span style="color: rgb(255, 0, 0);font-size: 14.6667px;">\n          <span>\n           <span style="color: rgb(0, 0, 0);">\n            1亿\n           </span>\n          </span>\n         </span>\n         <span style="font-size: 14.6667px;">\n          <span>\n           <span style="color: rgb(0, 0, 0);">\n            ，而这就形成了之前闹得沸沸扬扬的1亿vs 6000万的传闻\n           </span>\n          </span>\n         </span>\n        </section>\n        <section powered-by="werss">\n         <span style="font-size: 14.6667px;">\n          <span>\n           <span style="color: rgb(0, 0, 0);">\n            面对这个传闻，智元方面后来公开回应“不是真的”\n           </span>\n          </span>\n         </span>\n        </section>\n        <section powered-by="werss">\n         <span style="font-size: 14.6667px;">\n          <span>\n           <span style="color: rgb(0, 0, 0);">\n            随后时间，信息有所更新，宇树、智元、银河通用、松延动力、云深处等公司都加入了角逐，春晚方认为想要获得独家权益，价格预计在5亿左右，这超出了任何一家具身智能公司的承受能力。」有接近竞标的人士说，「最终大约有五家左右的具身智能公司一起上春晚，每家出资1亿左右\n           </span>\n          </span>\n         </span>\n        </section>\n        <section powered-by="werss">\n         <span style="font-size: 14.6667px;">\n          <span>\n           <span style="color: rgb(0, 0, 0);">\n            在此格局下，甚至有人想到了另一个办法\n           </span>\n          </span>\n         </span>\n        </section>\n        <section powered-by="werss">\n         <span style="font-size: 14.6667px;">\n          <span>\n           <span style="color: rgb(0, 0, 0);">\n            比如我让你共享未来的资本收益，但你让我上春晚。央视融媒体基金参与了松延动力的Pre-B轮、云深处的C轮、以及银河通用的融资\n           </span>\n          </span>\n         </span>\n        </section>\n        <section powered-by="werss">\n         <span style="font-size: 14.6667px;">\n          <span>\n           <span style="color: rgb(0, 0, 0);">\n            除了这三个最出名的融资，众擎机器人也宣布获得央视融资\n           </span>\n          </span>\n         </span>\n        </section>\n        <section powered-by="werss">\n         <span style="font-size: 14.6667px;">\n          <section powered-by="werss" style="display: inline-block;text-indent: 0px;">\n           <img src="https://mmbiz.qpic.cn/sz_mmbiz_jpg/hmkxKic9qKJHgZKpcx3p3tkbcpNyJgL4afW2LsSWel3RAFy39zOZUCxFOYxK598tEx5ZcfaSfEgQP779GgVqrn8ogrjgMOibwbicMV1WkGibcXk/640?wx_fmt=other&amp;from=appmsg" style="left:0px;top:0px;width:100%;background-color:transparent;"/>\n          </section>\n         </span>\n        </section>\n        <section powered-by="werss">\n         <span style="font-size: 14.6667px;">\n          <span>\n           <span style="color: rgb(0, 0, 0);">\n            而巫师拉到另一个视角\n           </span>\n          </span>\n         </span>\n        </section>\n        <section powered-by="werss">\n         <span style="font-size: 14.6667px;">\n          <span>\n           <span style="color: rgb(0, 0, 0);">\n            春晚大爆，资本发现原来机器人的主业其实是【卖艺】，各种\n           </span>\n          </span>\n         </span>\n         <span style="color: rgb(255, 0, 0);font-size: 14.6667px;">\n          <span>\n           <span style="color: rgb(0, 0, 0);">\n            展会、舞台、比赛、明星演唱会\n           </span>\n          </span>\n         </span>\n         <span style="font-size: 14.6667px;">\n          <span>\n           <span style="color: rgb(0, 0, 0);">\n            ，好像比让机器人进工厂干活或者服务人类，更容易吸引到下一轮融资，声量更大\n           </span>\n          </span>\n         </span>\n        </section>\n        <section powered-by="werss">\n         <span style="font-size: 14.6667px;">\n          <span>\n           <span style="color: rgb(0, 0, 0);">\n            而另一边，人形机器人的大规模普及和商业化，还面临着\n           </span>\n          </span>\n         </span>\n         <span style="color: rgb(255, 0, 0);font-size: 14.6667px;">\n          <span>\n           <span style="color: rgb(0, 0, 0);">\n            可靠性、产能、稳定性、成本\n           </span>\n          </span>\n         </span>\n         <span style="font-size: 14.6667px;">\n          <span>\n           <span style="color: rgb(0, 0, 0);">\n            等好几座大山\n           </span>\n          </span>\n         </span>\n        </section>\n        <section powered-by="werss">\n         <span style="font-size: 14.6667px;">\n          <span>\n           <span style="color: rgb(0, 0, 0);">\n            巫师的评价是，春晚才是具身智能最完美的“舒适区”，工厂/家庭/商超/车间/农田等等，地形复杂、结构复杂，户外场景更是亮度湿度温度风速不可控、，最重要的是需要机器人像人一样灵活应对各种状况，Which现在技术上还有多条沟壑\n           </span>\n          </span>\n         </span>\n        </section>\n        <section powered-by="werss">\n         <span style="font-size: 14.6667px;">\n          <span>\n           <span style="color: rgb(0, 0, 0);">\n            即使强如特斯拉的Optimus机器人之前也人设崩塌，并未佩戴任何眼部设备的机器人，竟突然抬起右手，做出了精准且流畅的“摘头显”动作。市场推测背后其实是有远程操作员在操作，而这个动作是摘下了自己的 VR 头显的标准动作，可能是设备故障或者发热，让远程操作员不得不在未断开连接的情况下，慌乱的摘下设备，这引发大众对具身智能到底是不是真智能，亦或者只是个\n           </span>\n          </span>\n         </span>\n         <span style="color: rgb(255, 0, 0);font-size: 14.6667px;">\n          <span>\n           <span style="color: rgb(0, 0, 0);">\n            提线木偶\n           </span>\n          </span>\n         </span>\n         <span style="font-size: 14.6667px;">\n          <span>\n           <span style="color: rgb(0, 0, 0);">\n            ”。为了虚张声势和快速融资的资本游戏的质疑\n           </span>\n          </span>\n         </span>\n        </section>\n        <section powered-by="werss">\n         <span style="font-size: 14.6667px;">\n          <span>\n           <span style="color: rgb(0, 0, 0);">\n            机器人目前的瓶颈\n           </span>\n          </span>\n         </span>\n         <span style="color: rgb(255, 0, 0);font-size: 14.6667px;">\n          <span>\n           <span style="color: rgb(0, 0, 0);">\n            在实际场景是短板，但在舞台上反而全是优势\n           </span>\n          </span>\n         </span>\n        </section>\n        <section powered-by="werss">\n         <span style="font-size: 14.6667px;">\n          <span>\n           <span style="color: rgb(0, 0, 0);">\n            春晚舞台地面是绝对平整且高摩擦力，室内空气湿度风速基本稳定，不用考虑气候，而且灯光明亮且是预设好的，甚至连背景音乐的节拍都是毫秒级同步的。程序早就写好了，机器人也不需要“思考”，不需要应对，只需要“执行”预设好的轨迹\n           </span>\n          </span>\n         </span>\n        </section>\n        <section powered-by="werss">\n         <span style="font-size: 14.6667px;">\n          <span>\n           <span style="color: rgb(0, 0, 0);">\n            既然现在机器人还没有大规模商业化，那靠什么维持百亿、千亿甚至万亿估值，一个字——\n           </span>\n          </span>\n         </span>\n         <span style="color: rgb(255, 0, 0);font-size: 14.6667px;">\n          <span>\n           <span style="color: rgb(0, 0, 0);">\n            哇\n           </span>\n          </span>\n         </span>\n         <span style="font-size: 14.6667px;">\n          <span>\n           <span style="color: rgb(0, 0, 0);">\n            ，几亿观众，只要大家发出一声“哇，未来科技好厉害，视觉整齐划一下的热度和赞美，让资方感到安心，我如果投你，我不会要求你马上要卖出去多少万台机器人，我也不奢求你能赚多少钱，我只要求我投进去的钱，\n           </span>\n          </span>\n         </span>\n         <span style="color: rgb(255, 0, 0);font-size: 14.6667px;">\n          <span>\n           <span style="color: rgb(0, 0, 0);">\n            要么由下几轮投资者接盘，要么以后你上市后让股民接盘\n           </span>\n          </span>\n         </span>\n         <span style="font-size: 14.6667px;">\n          <span>\n           <span style="color: rgb(0, 0, 0);">\n            ，这个概念只要民众相信，我就能实现几倍几十倍的利润\n           </span>\n          </span>\n         </span>\n        </section>\n        <section powered-by="werss">\n         <span style="font-size: 14.6667px;">\n          <span>\n           <span style="color: rgb(0, 0, 0);">\n            市场上即使是比较乐观的预测，也把机器人爆发周期放在10年以后，而且增长较为线性，增长曲线远达不到“J”型，目前处于……爆发前夜，的前夜\n           </span>\n          </span>\n         </span>\n        </section>\n        <section powered-by="werss">\n         <span style="font-size: 14.6667px;">\n          <section powered-by="werss" style="display: inline-block;text-indent: 0px;">\n           <img src="https://mmbiz.qpic.cn/mmbiz_jpg/hmkxKic9qKJGnSENib35Cc5qSK2FiccYP0WQSHJMDZo0iag5vbFPWgS8hvbrCr2QWQME5tYpbMGJnkXxApq32IKmAibq9f3jPccsSP3AdaPJN9OM/640?wx_fmt=other&amp;from=appmsg" style="left:0px;top:0px;width:100%;background-color:transparent;"/>\n          </section>\n         </span>\n        </section>\n        <section powered-by="werss">\n         <span style="font-size: 14.6667px;">\n          <span>\n           <span style="color: rgb(0, 0, 0);">\n            你是不是觉得，这不太对，好像在骗人，但巫师再给一个反直觉的观点，其实在\n           </span>\n          </span>\n         </span>\n         <span style="color: rgb(255, 0, 0);font-size: 14.6667px;">\n          <span>\n           <span style="color: rgb(0, 0, 0);">\n            需要大量资金的，并且周期极长的产业\n           </span>\n          </span>\n         </span>\n         <span style="font-size: 14.6667px;">\n          <span>\n           <span style="color: rgb(0, 0, 0);">\n            ，这个玩法，反而很不错\n           </span>\n          </span>\n         </span>\n        </section>\n        <section powered-by="werss">\n         <span style="font-size: 14.6667px;">\n          <span>\n           <span style="color: rgb(0, 0, 0);">\n            先在最有声量的场景刷存在感，把估值和融资先拿到手，再用这些钱去攻克真正的技术难关，\n           </span>\n          </span>\n         </span>\n         <span style="color: rgb(255, 0, 0);font-size: 14.6667px;">\n          <span>\n           <span style="color: rgb(0, 0, 0);">\n            在发展中解决问题\n           </span>\n          </span>\n         </span>\n        </section>\n        <section powered-by="werss">\n         <span style="font-size: 14.6667px;">\n          <span>\n           <span style="color: rgb(0, 0, 0);">\n            有人说，我一顿饭吃五个馒头就饱了，聪明人一想，那我直接吃第五个馒头行吗，大家都知道不行，春晚、机器人、各种表演、资本游戏，就是现在的前四个馒头\n           </span>\n          </span>\n         </span>\n        </section>\n        <section powered-by="werss">\n         <span style="font-size: 14.6667px;">\n          <span>\n           <span style="color: rgb(0, 0, 0);">\n            更进一步，这场资本盛宴最酣之时，站在卖方（投行）的视角，\n           </span>\n          </span>\n         </span>\n         <span style="color: rgb(255, 0, 0);font-size: 14.6667px;">\n          <span>\n           <span style="color: rgb(0, 0, 0);">\n            大逃杀开始缩圈了\n           </span>\n          </span>\n         </span>\n        </section>\n        <section powered-by="werss">\n         <span style="font-size: 14.6667px;">\n          <span>\n           <span style="color: rgb(0, 0, 0);">\n            一个冷知识，机器人在2016年就上过春晚了，当时 540台小型机器人编队表演。此后18年、19年、21年，优必选机器人继续登台\n           </span>\n          </span>\n         </span>\n        </section>\n        <section powered-by="werss">\n         <span style="font-size: 14.6667px;">\n          <span>\n           <span style="color: rgb(0, 0, 0);">\n            而如今群雄逐鹿，资本市场开始客观的审视每家公司的业绩\n           </span>\n          </span>\n         </span>\n        </section>\n        <section powered-by="werss">\n         <span style="font-size: 14.6667px;">\n          <span>\n           <span style="color: rgb(0, 0, 0);">\n            如果到2026年下半年，业绩上难以拿出实打实的成绩，二级市场的热度必然降温，从而传导到一级市场，融资就会变得困难，如果有的企业拿不到持续的融资输血了，那将面临淘汰的压力，我之前常说的新能源车企大逃杀，其实在各个行业都会看到相似的现象\n           </span>\n          </span>\n         </span>\n        </section>\n        <section powered-by="werss">\n         <span style="font-size: 14.6667px;">\n          <span>\n           <span style="color: rgb(0, 0, 0);">\n            2026年春晚对这些公司来说，可能是\n           </span>\n          </span>\n         </span>\n         <span style="color: rgb(255, 0, 0);font-size: 14.6667px;">\n          <span>\n           <span style="color: rgb(0, 0, 0);">\n            最后一次高调亮相的机会\n           </span>\n          </span>\n         </span>\n         <span style="font-size: 14.6667px;">\n          <span>\n           <span style="color: rgb(0, 0, 0);">\n            ，大众的审美会趋于疲惫，声量和热度不会一直处于巅峰，资方的耐心也是有限的，以后这种动辄几亿的营销预算，不一定还能这么轻松的就拍板\n           </span>\n          </span>\n         </span>\n        </section>\n        <section powered-by="werss">\n         <span style="font-size: 14.6667px;">\n          <span>\n           <span style="color: rgb(0, 0, 0);">\n            所以从巫师这个角度讲，具身智能行业谁会率先盈利从而吃到第一块蛋糕呢，答案已经出炉——就是春晚自己\n           </span>\n          </span>\n         </span>\n        </section>\n        <section powered-by="werss">\n         <span style="font-size: 21.3333px;">\n          <span>\n           <span style="color: rgb(0, 0, 0);font-weight: bold;">\n            AI\n           </span>\n          </span>\n         </span>\n        </section>\n        <section powered-by="werss">\n         <span style="background-color: cyan;font-size: 14.6667px;">\n          <span>\n           <span style="background-color: rgb(255, 255, 255);color: rgb(0, 0, 0);">\n            其实科技产业更大的赛道是AI\n           </span>\n          </span>\n         </span>\n        </section>\n        <section powered-by="werss">\n         <span style="background-color: cyan;font-size: 14.6667px;">\n          <span>\n           <span style="background-color: rgb(255, 255, 255);color: rgb(0, 0, 0);">\n            字节火山引擎是今年央视春晚独家AI云合作伙伴，旗下产品豆包将深度嵌入春晚互动，市场上鲜有公开信息，但巫师倒推，整体级别应在5亿至8亿之间\n           </span>\n          </span>\n         </span>\n        </section>\n        <section powered-by="werss">\n         <span style="background-color: cyan;font-size: 14.6667px;">\n          <span>\n           <span style="background-color: rgb(255, 255, 255);color: rgb(0, 0, 0);">\n            同时阿里千问宣布启动“春节请客计划”，联合了淘宝、盒马、飞猪、支付宝等全家桶业务，以免单的形式请用户在春节期间吃喝玩乐，官方表示投入达到30亿\n           </span>\n          </span>\n         </span>\n        </section>\n        <section powered-by="werss">\n         <span style="background-color: cyan;font-size: 14.6667px;">\n          <span>\n           <span style="background-color: rgb(255, 255, 255);color: rgb(0, 0, 0);">\n            但最直接最狠的投入还得看腾讯\n           </span>\n          </span>\n         </span>\n        </section>\n        <section powered-by="werss">\n         <span style="background-color: cyan;font-size: 14.6667px;">\n          <span>\n           <span style="background-color: rgb(255, 255, 255);color: rgb(0, 0, 0);">\n            由于腾讯在AI赛道上的慢半拍，腾讯现在有点着急了\n           </span>\n          </span>\n         </span>\n        </section>\n        <section powered-by="werss">\n         <span style="background-color: cyan;font-size: 14.6667px;">\n          <span>\n           <span style="background-color: rgb(255, 255, 255);color: rgb(0, 0, 0);">\n            腾讯元宝2月1日起发放10亿现金红包，单个最高1万，可直接提现至微信。马化腾直言"希望重现当年微信红包的盛况"，这句话他指的是2014年春晚那一战役，也就是被马云说成是偷袭珍珠港的一役，一会儿细说\n           </span>\n          </span>\n         </span>\n        </section>\n        <section powered-by="werss">\n         <span style="background-color: cyan;font-size: 14.6667px;">\n          <span>\n           <span style="background-color: rgb(255, 255, 255);color: rgb(0, 0, 0);">\n            目前的市场共识是，AI将取代所有牛鬼蛇神、成为互联网用户未来的核心入口，现在不是说你拿到了AI这个时代的门票你就能起飞，而是哪个大厂拿不到这张门票，谁就会被时代抛弃\n           </span>\n          </span>\n         </span>\n        </section>\n        <section powered-by="werss">\n         <span style="background-color: cyan;font-size: 14.6667px;">\n          <span>\n           <span style="background-color: rgb(255, 255, 255);color: rgb(0, 0, 0);">\n            但是搞笑的是，AI大厂红包大战，大家褒贬不一，有拍手叫好，真给钱就行，先薅为敬，也有网友直言【被恶心了】，被市场唾弃的病毒式营销大肆席卷，用户看不到群内正常消息和讨论，被淹没在了红包链接中\n           </span>\n          </span>\n         </span>\n        </section>\n        <section powered-by="werss">\n         <span style="background-color: cyan;font-size: 14.6667px;">\n          <span>\n           <span style="background-color: rgb(255, 255, 255);color: rgb(0, 0, 0);">\n            相关互联网企业的股价在2月初上演了一次小砸盘，资本市场的逻辑和之前外卖大战相似，美团京东阿里在狂撒外卖红包时，股价震荡下行，市场认为过度补贴用户会消耗现金储备，而且拖累企业利润，但巫师认为这里面区别很大，外卖平台可以靠低价和补贴吸引用户，并且\n           </span>\n          </span>\n         </span>\n         <span style="color: rgb(255, 0, 0);background-color: cyan;font-size: 14.6667px;">\n          <span>\n           <span style="background-color: rgb(255, 255, 255);color: rgb(0, 0, 0);">\n            留住\n           </span>\n          </span>\n         </span>\n         <span style="background-color: cyan;font-size: 14.6667px;">\n          <span>\n           <span style="background-color: rgb(255, 255, 255);color: rgb(0, 0, 0);">\n            用户，至少点一杯星巴克，通过美团送，或者通过淘宝闪购送，咖啡本身没有任何区别\n           </span>\n          </span>\n         </span>\n        </section>\n        <section powered-by="werss">\n         <span style="background-color: cyan;font-size: 14.6667px;">\n          <span>\n           <span style="background-color: rgb(255, 255, 255);color: rgb(0, 0, 0);">\n            但AI产品可不是，各家差距很大，巫师认为最优秀当然是最新发布的……抱歉，这期没接到广子\n           </span>\n          </span>\n         </span>\n        </section>\n        <section powered-by="werss">\n         <span style="background-color: cyan;font-size: 14.6667px;">\n          <span>\n           <span style="background-color: rgb(255, 255, 255);color: rgb(0, 0, 0);">\n            AI大厂花钱买流量更多的还是让大家体验一下，\n           </span>\n          </span>\n         </span>\n         <span style="color: rgb(255, 0, 0);background-color: cyan;font-size: 14.6667px;">\n          <span>\n           <span style="background-color: rgb(255, 255, 255);color: rgb(0, 0, 0);">\n            AI产品让大家触达是靠“票子”，而让大家留下来用，则是要靠“脑子”\n           </span>\n          </span>\n         </span>\n        </section>\n        <section powered-by="werss">\n         <span style="background-color: cyan;font-size: 14.6667px;">\n          <span>\n           <span style="background-color: rgb(255, 255, 255);color: rgb(0, 0, 0);">\n            请把你们觉得脑子最好的国内AI产品，和海外AI产品，分别打出来看看，咱们观测一下谁是现在的口碑之王\n           </span>\n          </span>\n         </span>\n        </section>\n        <section powered-by="werss">\n         <span style="background-color: cyan;font-size: 14.6667px;">\n          <span>\n           <span style="background-color: rgb(255, 255, 255);color: rgb(0, 0, 0);">\n            大厂们也知道最终要靠脑子留人，但像春晚这种动辄几亿和各种庞大的营销预算为什么还要\n           </span>\n          </span>\n         </span>\n         <span style="color: rgb(255, 0, 0);background-color: cyan;font-size: 14.6667px;">\n          <span>\n           <span style="background-color: rgb(255, 255, 255);color: rgb(0, 0, 0);">\n            “明知故花”\n           </span>\n          </span>\n         </span>\n        </section>\n        <section powered-by="werss">\n         <span style="background-color: cyan;font-size: 14.6667px;">\n          <span>\n           <span style="background-color: rgb(255, 255, 255);color: rgb(0, 0, 0);">\n            一是触达的用户群不一样，一个冷知识，中国互联网络信息中心去年发布的报告（《生成式人工智能应用发展报告（2025）》）指出，AI用户规模 5.15 亿，普及率达36.5%，也就是说，大约9 亿人还没触达正经的AI产品，很多人觉得这个数据魔幻，纷纷表示自己周围的人怎么怎么样，但要知道你是一个看财经内容的用户，你所代表的认知水平、消费水平以及财富阶层，虽然很高，但其实也是你的【茧房】，你看到周围人站在时代的潮头，但很难看到那9亿“慢半拍的人”\n           </span>\n          </span>\n         </span>\n        </section>\n        <section powered-by="werss">\n         <span style="background-color: cyan;font-size: 14.6667px;">\n          <span>\n           <span style="background-color: rgb(255, 255, 255);color: rgb(0, 0, 0);">\n            反而春晚可以触达的是三四线城市、中老年群体这种下沉市场\n           </span>\n          </span>\n         </span>\n        </section>\n        <section powered-by="werss">\n         <span style="background-color: cyan;font-size: 14.6667px;">\n          <span>\n           <span style="background-color: rgb(255, 255, 255);color: rgb(0, 0, 0);">\n            第二则是\n           </span>\n          </span>\n         </span>\n         <span style="color: rgb(255, 0, 0);background-color: cyan;font-size: 14.6667px;">\n          <span>\n           <span style="background-color: rgb(255, 255, 255);color: rgb(0, 0, 0);">\n            卡位和防御\n           </span>\n          </span>\n         </span>\n         <span style="background-color: cyan;font-size: 14.6667px;">\n          <span>\n           <span style="background-color: rgb(255, 255, 255);color: rgb(0, 0, 0);">\n            ，这块地就这么大，你不占领，竞争对手就占上了\n           </span>\n          </span>\n         </span>\n        </section>\n        <section powered-by="werss">\n         <span style="background-color: cyan;font-size: 14.6667px;">\n          <span>\n           <span style="background-color: rgb(255, 255, 255);color: rgb(0, 0, 0);">\n            第三则是巫师站在企业内部给大家一个视角，哪怕是巫师的投行职业生涯，这种事儿也司空见惯，就是内部需要"花钱交代"，有预算要花，有OKR要完成，说明你们团队还“有用”，各种投放和花钱的意义，有一部分就是花钱本身\n           </span>\n          </span>\n         </span>\n        </section>\n        <section powered-by="werss">\n         <span style="background-color: cyan;font-size: 14.6667px;">\n          <span>\n           <span style="background-color: rgb(255, 255, 255);color: rgb(0, 0, 0);">\n            记住我这句话，\n           </span>\n          </span>\n         </span>\n         <span style="color: rgb(255, 0, 0);background-color: cyan;font-size: 14.6667px;">\n          <span>\n           <span style="background-color: rgb(255, 255, 255);color: rgb(0, 0, 0);">\n            预算多少，就是你在集团内的地盘有多大\n           </span>\n          </span>\n         </span>\n         <span style="background-color: cyan;font-size: 14.6667px;">\n          <span>\n           <span style="background-color: rgb(255, 255, 255);color: rgb(0, 0, 0);">\n            ，其他的花里胡哨的都是扯淡，这里不展开，推荐大家去看我年度财经TOP10的第十名\n           </span>\n          </span>\n         </span>\n        </section>\n        <section powered-by="werss">\n         <span style="background-color: cyan;font-size: 14.6667px;">\n          <section powered-by="werss" style="display: inline-block;text-indent: 0px;">\n           <img src="https://mmbiz.qpic.cn/mmbiz_jpg/hmkxKic9qKJF25L9af0lWcbicG3lX7xHDNAyoowgnZ9zqsJ00dW6OIIBGVFBgNuqAkh3A6Z9fBCagPIJBliaTH3yxVsb7jdYOaw3or2wCaCI00/640?wx_fmt=other&amp;from=appmsg" style="left:0px;top:0px;width:100%;background-color:transparent;"/>\n          </section>\n         </span>\n        </section>\n        <section powered-by="werss">\n         <span style="background-color: cyan;font-size: 14.6667px;">\n          <span>\n           <span style="background-color: rgb(255, 255, 255);color: rgb(0, 0, 0);">\n            而我推测更深的一点，以腾讯为例\n           </span>\n          </span>\n         </span>\n        </section>\n        <section powered-by="werss">\n         <span style="background-color: cyan;font-size: 14.6667px;">\n          <span>\n           <span style="background-color: rgb(255, 255, 255);color: rgb(0, 0, 0);">\n            在元宝开始发红包没两天，微信团队就制裁元宝的红包链接了，表示活动干扰平台生态秩序、对用户造成骚扰\n           </span>\n          </span>\n         </span>\n        </section>\n        <section powered-by="werss">\n         <span style="background-color: cyan;font-size: 14.6667px;">\n          <section powered-by="werss" style="display: inline-block;text-indent: 0px;">\n           <img src="https://mmbiz.qpic.cn/mmbiz_png/b2xrCaupfLtHo1yicq7x8HiaNTEr0mHOH9acezU5mK99qURVPfVA4oNibZVCxGm1M3V5NN0FibxicgX7ia2g3S31YIibksQ4xEXsnVdkYOdiashcvGg/640?from=appmsg" style="left:0px;top:0px;width:250px;background-color:transparent;height:293px;"/>\n          </section>\n         </span>\n        </section>\n        <section powered-by="werss">\n         <span style="background-color: cyan;font-size: 14.6667px;">\n          <span>\n           <span style="background-color: rgb(255, 255, 255);color: rgb(0, 0, 0);">\n            这些新春佳节的活动背后，哪个又不是一场内部地盘和权力的博弈呢\n           </span>\n          </span>\n         </span>\n        </section>\n        <section powered-by="werss">\n         <span>\n          <span style=\'color: rgba(0, 0, 0, 0.9);font-size: 15px;font-family: "mp-quote", "PingFang SC", system-ui, -apple-system, BlinkMacSystemFont, "Helvetica Neue", "Hiragino Sans GB", "Microsoft YaHei UI", "Microsoft YaHei", Arial, sans-serif;line-height: 1.6;letter-spacing: 0.034em;font-style: normal;font-weight: normal;\'>\n           腾讯对自己都这么狠，对对家就更别提了，阿里千问红包链接也被微信屏蔽，还记得刚刚说到千问以免单的形式请用户吃喝玩乐吗，前几天第一波高潮是邀请用户用\n          </span>\n          <font face="等线">\n           <span style=\'color: rgba(0, 0, 0, 0.9);font-size: 15px;font-family: "mp-quote", "PingFang SC", system-ui, -apple-system, BlinkMacSystemFont, "Helvetica Neue", "Hiragino Sans GB", "Microsoft YaHei UI", "Microsoft YaHei", Arial, sans-serif;line-height: 1.6;letter-spacing: 0.034em;font-style: normal;font-weight: normal;\'>\n            AI一句话免费点奶茶，一瞬间，阿里系外卖平台的流量也顺带着被拉满，奶茶爆单，甚至一线城市中心办公楼密集的区域，有的奶茶门店排到了1400多杯，用户的狂欢，满桌的订单，疯狂的店员，焦急的骑手，这一波，你们薅到了多少\n           </span>\n          </font>\n         </span>\n        </section>\n        <section powered-by="werss" style="text-align: center;">\n         <img src="https://mmbiz.qpic.cn/sz_mmbiz_png/hmkxKic9qKJGK9aVQ4oVqUqjP1um2MQawAjvBGNnn2y7e9wr70uQkcC8dxADyjHRkb8tvAqzKDjaRHDbEDNQgibwTnQkrYg0WuSh7Dcyss8H0/640?wx_fmt=png&amp;from=appmsg" style="width:271px;height:362px;"/>\n        </section>\n        <section powered-by="werss" style="text-align: center;">\n         <img src="https://mmbiz.qpic.cn/sz_mmbiz_png/hmkxKic9qKJFBVITQOrrVUVkf9fSia2pIf330D0dibLGaOmqgUZ9mKCPQxIcRojYvv4iaic3ebHYsfp19kK5kwy7OHSOxJDWY8NL5K2ckmyiaeDd8/640?wx_fmt=png&amp;from=appmsg" style="width:290px;height:428px;"/>\n        </section>\n        <section powered-by="werss">\n         <span style="background-color: cyan;font-size: 14.6667px;">\n          <span>\n           <span style="background-color: rgb(255, 255, 255);color: rgb(0, 0, 0);">\n            这场AI资本们在春节舞台的撒币大战，让巫师梦回十年之前\n           </span>\n          </span>\n         </span>\n        </section>\n        <section powered-by="werss">\n         <span style="font-size: 21.3333px;">\n          <span>\n           <span style="color: rgb(0, 0, 0);font-weight: bold;">\n            大厂十年混战\n           </span>\n          </span>\n         </span>\n        </section>\n        <section powered-by="werss">\n         <span style="font-size: 14.6667px;">\n          <span>\n           <span style="color: rgb(0, 0, 0);">\n            大厂们在春晚这个舞台上打了十年，巫师给你们一个上帝视角，可以暂停看，先说结论，\n           </span>\n          </span>\n         </span>\n         <span style="color: rgb(255, 0, 0);font-size: 14.6667px;">\n          <span>\n           <span style="color: rgb(0, 0, 0);">\n            一家大赢，一家小赢，多家平平，一家血亏\n           </span>\n          </span>\n         </span>\n        </section>\n        <section powered-by="werss">\n         <span style="font-size: 14.6667px;">\n          <section powered-by="werss" style="display: inline-block;text-indent: 0px;">\n           <img src="https://mmbiz.qpic.cn/mmbiz_jpg/hmkxKic9qKJGoOTwI9VJ4udJ1Bx9PyPKhvBUIZXEvibMtNXAfbHgFyzaLt80tDymxgwCTbDE0jFxlh7Wia8yKLJFiafQt2f1VYSiaQ2DqT8h9RSc/640?wx_fmt=other&amp;from=appmsg" style="left:0px;top:0px;width:100%;background-color:transparent;"/>\n          </section>\n         </span>\n        </section>\n        <section powered-by="werss">\n         <span style="font-size: 14.6667px;">\n          <span>\n           <span style="color: rgb(0, 0, 0);">\n            大厂们在春晚舞台上的博弈目的就两个大字——\n           </span>\n          </span>\n         </span>\n         <span style="color: rgb(255, 0, 0);font-size: 14.6667px;">\n          <span>\n           <span style="color: rgb(0, 0, 0);">\n            抢你\n           </span>\n          </span>\n         </span>\n         <span style="font-size: 14.6667px;">\n          <span>\n           <span style="color: rgb(0, 0, 0);">\n            ，对争抢屏幕前的你们，所以效果如何就是要看DAU也就是日活跃用户增长，这里面唯一大赢特赢的，相较于其他媒体含糊不清的观点，巫师告诉你就是腾讯一家\n           </span>\n          </span>\n         </span>\n        </section>\n        <section powered-by="werss">\n         <span style="font-size: 14.6667px;">\n          <span>\n           <span style="color: rgb(0, 0, 0);">\n            2015腾讯以5300万元的低价中标春晚，并在除夕推出5亿"摇一摇"红包。当晚摇红包达到110亿人次，网传两天内微信绑定了个人银行卡2亿张，但巫师不太相信这个数据，但总之绑卡人数暴涨\n           </span>\n          </span>\n         </span>\n        </section>\n        <section powered-by="werss">\n         <span style="font-size: 14.6667px;">\n          <span>\n           <span style="color: rgb(0, 0, 0);">\n            2014年，支付宝份额高达82.8%。而在2015年春晚结束后，微信"财付通"市场份额已暴涨至20.6%，支付宝下降到了68.4%\n           </span>\n          </span>\n         </span>\n        </section>\n        <section powered-by="werss">\n         <span style="font-size: 14.6667px;">\n          <section powered-by="werss" style="display: inline-block;text-indent: 0px;">\n           <img src="https://mmbiz.qpic.cn/sz_mmbiz_jpg/hmkxKic9qKJGIq1Z8WiaREnA6pmOotIicm383pL00yav4u3TQZE4TS9FBG4I6HoAiaEDq85ocNGQiaKPob3E03L5xPoTO1acMm1icib9NJubyOHZT0/640?wx_fmt=other&amp;from=appmsg" style="left:0px;top:0px;width:100%;background-color:transparent;"/>\n          </section>\n         </span>\n        </section>\n        <section powered-by="werss">\n         <span style="font-size: 14.6667px;">\n          <span>\n           <span style="color: rgb(0, 0, 0);">\n            生生从支付宝嘴里抢了一块肉下来，而另一个维度，绑卡2亿人，支付宝用了9年时间。而腾讯只用了一晚上，从此微信支付（财付通）进入快车道，并发展到今天与支付宝比肩，合占94%移动支付的重要支付方式\n           </span>\n          </span>\n         </span>\n        </section>\n        <section powered-by="werss">\n         <span style="font-size: 14.6667px;">\n          <span>\n           <span style="color: rgb(0, 0, 0);">\n            这一战让腾讯从游戏+社交，直接进化成了\n           </span>\n          </span>\n         </span>\n         <span style="color: rgb(255, 0, 0);font-size: 14.6667px;">\n          <span>\n           <span style="color: rgb(0, 0, 0);">\n            游戏+社交+金融+科技巨头\n           </span>\n          </span>\n         </span>\n         <span style="font-size: 14.6667px;">\n          <span>\n           <span style="color: rgb(0, 0, 0);">\n            。不但当时股价应声大涨，而且此役亦支撑了腾讯后来十年不断上涨为万亿市值的地基\n           </span>\n          </span>\n         </span>\n        </section>\n        <section powered-by="werss">\n         <span style="font-size: 14.6667px;">\n          <span>\n           <span style="color: rgb(0, 0, 0);">\n            这事儿给阿里气坏了，马云事后称这次战役为“\n           </span>\n          </span>\n         </span>\n         <span style="color: rgb(255, 0, 0);font-size: 14.6667px;">\n          <span>\n           <span style="color: rgb(0, 0, 0);">\n            珍珠港偷袭\n           </span>\n          </span>\n         </span>\n         <span style="font-size: 14.6667px;">\n          <span>\n           <span style="color: rgb(0, 0, 0);">\n            ”，直接给马云打成了PTSD\n           </span>\n          </span>\n         </span>\n        </section>\n        <section powered-by="werss">\n         <span style="font-size: 14.6667px;">\n          <span>\n           <span style="color: rgb(0, 0, 0);">\n            那么谁是真正的受益者呢，还是春晚\n           </span>\n          </span>\n         </span>\n        </section>\n        <section powered-by="werss">\n         <span style="font-size: 14.6667px;">\n          <span>\n           <span style="color: rgb(0, 0, 0);">\n            随后的2016至2018：支付宝为了夺回春晚，花了好几倍的价钱，"\n           </span>\n          </span>\n         </span>\n         <span style="color: rgb(255, 0, 0);font-size: 14.6667px;">\n          <span>\n           <span style="color: rgb(0, 0, 0);">\n            央视有个投标，我们没拿到，对方非常拼\n           </span>\n          </span>\n         </span>\n         <span style="font-size: 14.6667px;">\n          <span>\n           <span style="color: rgb(0, 0, 0);">\n            "——这是马化腾在2015年互联网大会上演讲时说的一句话。\n           </span>\n          </span>\n         </span>\n        </section>\n        <section powered-by="werss">\n         <span style="font-size: 14.6667px;">\n          <span>\n           <span style="color: rgb(0, 0, 0);">\n            然后就是支付宝的集五福了，留存率其实也还行，但此战的意义不只是拉新，而是防御，支付二字是阿里的主基地，可不能被偷了\n           </span>\n          </span>\n         </span>\n        </section>\n        <section powered-by="werss">\n         <span style="font-size: 14.6667px;">\n          <span>\n           <span style="color: rgb(0, 0, 0);">\n            但大厂们还是小看了春晚的能量，2018年为了防止服务器崩溃，阿里云扩容了数倍，结果当晚流量还是超出了预期的3倍，据报道，春晚的流量冲击是当时“双十一”峰值的15倍\n           </span>\n          </span>\n         </span>\n        </section>\n        <section powered-by="werss">\n         <span style="font-size: 14.6667px;">\n          <span>\n           <span style="color: rgb(0, 0, 0);">\n            综合来看，阿里算是小赚\n           </span>\n          </span>\n         </span>\n        </section>\n        <section powered-by="werss">\n         <span style="font-size: 14.6667px;">\n          <span>\n           <span style="color: rgb(0, 0, 0);">\n            下面的2019年，是互联网资本里最亏的一战——\n           </span>\n          </span>\n         </span>\n         <span style="color: rgb(255, 0, 0);font-size: 14.6667px;">\n          <span>\n           <span style="color: rgb(0, 0, 0);">\n            百度\n           </span>\n          </span>\n         </span>\n        </section>\n        <section powered-by="werss">\n         <span style="font-size: 14.6667px;">\n          <span>\n           <span style="color: rgb(0, 0, 0);">\n            2019的百度把价码拉升至9亿，当然，9亿必然可以听个响，除夕当晚，百度APP的日活跃用户数冲上3亿，相较上一年年底的1.6亿几近翻倍。同时试图推广全家桶，百度App、好看视频、贴吧等\n           </span>\n          </span>\n         </span>\n        </section>\n        <section powered-by="werss">\n         <span style="font-size: 14.6667px;">\n          <span>\n           <span style="color: rgb(0, 0, 0);">\n            可在除夕之后，百度APP的7日内新用户留存率只有2%\n           </span>\n          </span>\n         </span>\n        </section>\n        <section powered-by="werss">\n         <span style="font-size: 14.6667px;">\n          <span>\n           <span style="color: rgb(0, 0, 0);">\n            可以说是——\n           </span>\n          </span>\n         </span>\n         <span style="color: rgb(255, 0, 0);font-size: 14.6667px;">\n          <span>\n           <span style="color: rgb(0, 0, 0);">\n            羊毛党狂欢，百度买单，\n           </span>\n          </span>\n         </span>\n         <span style="font-size: 14.6667px;">\n          <span>\n           <span style="color: rgb(0, 0, 0);">\n            抢完红包，下完就删\n           </span>\n          </span>\n         </span>\n        </section>\n        <section powered-by="werss">\n         <span style="font-size: 14.6667px;">\n          <span>\n           <span style="color: rgb(0, 0, 0);">\n            100个人里有98个是为了薅羊毛，我猜剩下两个里面有一个估计可能是忘了\n           </span>\n          </span>\n         </span>\n        </section>\n        <section powered-by="werss">\n         <span style="font-size: 14.6667px;">\n          <span>\n           <span style="color: rgb(0, 0, 0);">\n            资本市场非常失望。百度股价在2019年并没有起飞，反而因为高昂的营销费用拖累了Q1财报，出现了上市后的首次亏损，导致股价大跌\n           </span>\n          </span>\n         </span>\n        </section>\n        <section powered-by="werss">\n         <span style="font-size: 14.6667px;">\n          <section powered-by="werss" style="display: inline-block;text-indent: 0px;">\n           <img src="https://mmbiz.qpic.cn/sz_mmbiz_jpg/hmkxKic9qKJHg9Sye9wy4PfR5X9nEJhBeNBQic27w7efJXUBpTL83yEdwmEQl5raVklfZB0lEVrPic5jUVl04ib7mCk2j43RXicL7CHq53veclrQ/640?wx_fmt=other&amp;from=appmsg" style="left:0px;top:0px;width:100%;background-color:transparent;"/>\n          </section>\n         </span>\n        </section>\n        <section powered-by="werss">\n         <span style="font-size: 14.6667px;">\n          <span>\n           <span style="color: rgb(0, 0, 0);">\n            这时会有很多人联系到网上常说的，百度拉了，掉队了，干啥啥不行的叙事中去，但事实上也不是这样，百度真的是一家很有意思的公司，有机会好好出一期\n           </span>\n          </span>\n         </span>\n        </section>\n        <section powered-by="werss">\n         <span style="font-size: 14.6667px;">\n          <span>\n           <span style="color: rgb(0, 0, 0);">\n            在之后两年分别是快手10亿和抖音12亿，拉开了视频平台抢人的帷幕，这个我之前讲过了，而且巫师也是亲身参与者，打响了财经区的第一枪，老粉们也是吃瓜吃上来的\n           </span>\n          </span>\n         </span>\n        </section>\n        <section powered-by="werss">\n         <span style="font-size: 14.6667px;">\n          <span>\n           <span style="color: rgb(0, 0, 0);">\n            直到2022年春晚成为了互联网资本的狂欢终结，京东拿出价值15亿元红包和商品。但用户增长并不明显。京东当时\n           </span>\n          </span>\n         </span>\n         <span style="color: rgb(255, 0, 0);font-size: 14.6667px;">\n          <span>\n           <span style="color: rgb(0, 0, 0);">\n            MAU（月活跃用户\n           </span>\n          </span>\n         </span>\n         <span style="font-size: 14.6667px;">\n          <span>\n           <span style="color: rgb(0, 0, 0);">\n            ）约5.7亿；而春晚后的三个季度分别为5.8亿、5.8亿、5.9亿，增长几乎陷入停滞\n           </span>\n          </span>\n         </span>\n        </section>\n        <section powered-by="werss">\n         <span style="font-size: 14.6667px;">\n          <span>\n           <span style="color: rgb(0, 0, 0);">\n            春晚对于大厂们来说，\n           </span>\n          </span>\n         </span>\n         <span style="color: rgb(255, 0, 0);font-size: 14.6667px;">\n          <span>\n           <span style="color: rgb(0, 0, 0);">\n            从花小钱办大事，逐渐变为花大钱办小事\n           </span>\n          </span>\n         </span>\n         <span style="font-size: 14.6667px;">\n          <span>\n           <span style="color: rgb(0, 0, 0);">\n            ，\n           </span>\n          </span>\n         </span>\n         <span style="color: rgb(255, 0, 0);font-size: 14.6667px;">\n          <span>\n           <span style="color: rgb(0, 0, 0);">\n            甚至不办事还拖后腿\n           </span>\n          </span>\n         </span>\n         <span style="font-size: 14.6667px;">\n          <span>\n           <span style="color: rgb(0, 0, 0);">\n            ，背后的核心是移动互联网已进入存量时代，用户增量空间见顶，春晚也救不了互联网的增长瓶颈\n           </span>\n          </span>\n         </span>\n        </section>\n        <section powered-by="werss">\n         <span style="font-size: 14.6667px;">\n          <span>\n           <span style="color: rgb(0, 0, 0);">\n            烧钱买流量的时代迎来终结，降本增效和反内卷的时代来了，但伴随着中国科技创新的Deepseek时刻，我国新的增长点出现，AI、具身智能、创新药等行业代替互联网大厂们成了新的资本追逐的对象，就接上了巫师开头的故事\n           </span>\n          </span>\n         </span>\n        </section>\n        <section powered-by="werss">\n         <span style="font-size: 21.3333px;">\n          <span>\n           <span style="color: rgb(0, 0, 0);font-weight: bold;">\n            车企\n           </span>\n          </span>\n         </span>\n        </section>\n        <section powered-by="werss">\n         <span style="font-size: 14.6667px;">\n          <span>\n           <span style="color: rgb(0, 0, 0);">\n            如果说近十年是互联网大厂战争的退潮，那正好相反的，则是车企争奇斗艳的升级\n           </span>\n          </span>\n         </span>\n        </section>\n        <section powered-by="werss">\n         <span style="font-size: 14.6667px;">\n          <span>\n           <span style="color: rgb(0, 0, 0);">\n            从早年到2018，车企本来并不是春晚的常客， Jeep、东风日产、福特等传统品牌曾零星出现在春晚或前置广告时段中\n           </span>\n          </span>\n         </span>\n        </section>\n        <section powered-by="werss">\n         <span style="font-size: 14.6667px;">\n          <span>\n           <span style="color: rgb(0, 0, 0);">\n            直到2019国产新势力崛起，中国车企走上世界历史舞台，这个状况才发生逆转，2019年春晚长春分会场是红旗的主场，深圳分会场由比亚迪承包\n           </span>\n          </span>\n         </span>\n        </section>\n        <section powered-by="werss">\n         <span style="font-size: 14.6667px;">\n          <span>\n           <span style="color: rgb(0, 0, 0);">\n            2023年，红旗新能源成为春晚独家汽车合作伙伴\n           </span>\n          </span>\n         </span>\n        </section>\n        <section powered-by="werss">\n         <span style="font-size: 14.6667px;">\n          <span>\n           <span style="color: rgb(0, 0, 0);">\n            2024年春晚中出现的车企更是井喷式爆发，华为将问界M9植入背景大屏，还作为大奖送出。广汽传祺成为“小品道具”，而岚图虽然未直接登台，但通过作为京东（也就是当年的春晚合作平台）的奖品车，间接曝光。而当年爆款小米汽车SU7模型出现在观众席\n           </span>\n          </span>\n         </span>\n        </section>\n        <section powered-by="werss">\n         <span style="font-size: 14.6667px;">\n          <span>\n           <span style="color: rgb(0, 0, 0);">\n            还有东风、长安等也是2024春晚的赞助商\n           </span>\n          </span>\n         </span>\n        </section>\n        <section powered-by="werss">\n         <span style="font-size: 14.6667px;">\n          <span>\n           <span style="color: rgb(0, 0, 0);">\n            再到了2025年，鸿蒙智行的尊界S800在春晚亮相，问界 M9作为鸿蒙智行的销量担当再次登台。小米的车模也又一次出现在观众席，长安深蓝三辆车同时出现在央视大楼前\n           </span>\n          </span>\n         </span>\n        </section>\n        <section powered-by="werss">\n         <span style="font-size: 14.6667px;">\n          <span>\n           <span style="color: rgb(0, 0, 0);">\n            长安启源重庆分会场亮相，东风天翼纯电动公交车亮相武汉分会场，长城魏牌蓝山成为春晚新媒体直播指定用车\n           </span>\n          </span>\n         </span>\n        </section>\n        <section powered-by="werss">\n         <span style="font-size: 14.6667px;">\n          <span>\n           <span style="color: rgb(0, 0, 0);">\n            这段时期也是资本市场新能源车企股价涨幅最明显的时期，车企股价翻了三五倍都是常态，让不少人发了财，我之前一直看的一个生活区Up，后来不更视频去炒股了，据说从300万赚到1300万，据说其中的主菜就是比亚迪在资本市场的长期爆发，哎，说到这个就心疼，自己的失败固然可恨，但别人的成功更让人揪心\n           </span>\n          </span>\n         </span>\n        </section>\n        <section powered-by="werss">\n         <span style="font-size: 21.3333px;">\n          <span>\n           <span style="color: rgb(0, 0, 0);font-weight: bold;">\n            消费电子\n           </span>\n          </span>\n         </span>\n        </section>\n        <section powered-by="werss">\n         <span style="font-size: 14.6667px;">\n          <span>\n           <span style="color: rgb(0, 0, 0);">\n            同一段时期，除了车企，消费电子也是春晚重要金主，而手机品牌的战场中，呈现出【一超多强】的态势，一超就是华为\n           </span>\n          </span>\n         </span>\n        </section>\n        <section powered-by="werss">\n         <span style="font-size: 14.6667px;">\n          <span>\n           <span style="color: rgb(0, 0, 0);">\n            截至今年，华为已经连续7年重金砸向春晚，基本上每年华为的旗舰机型，都会在小品、魔术和歌曲中现身，同时会在分会场中展示其技术优势\n           </span>\n          </span>\n         </span>\n        </section>\n        <section powered-by="werss">\n         <span style="font-size: 14.6667px;">\n          <section powered-by="werss" style="display: inline-block;text-indent: 0px;">\n           <img src="https://mmbiz.qpic.cn/sz_mmbiz_jpg/hmkxKic9qKJGqCSvVwaA2m35qlMRTA4sJo7rDMoZ3D2UM5KfHetlWoyYsFSfSeHRLmldic0Xv4a4iajiaFGeXzqgibIVstUIfCKGnOasxtpFzJHk/640?wx_fmt=other&amp;from=appmsg" style="left:0px;top:0px;width:100%;background-color:transparent;"/>\n          </section>\n         </span>\n        </section>\n        <section powered-by="werss">\n         <span style="font-size: 14.6667px;">\n          <span>\n           <span style="color: rgb(0, 0, 0);">\n            而OPPO另辟蹊径，主要以开播前广告时段投放，2024年更是很有创意的在春晚开播前召开"OPPO史上最短发布会"\n           </span>\n          </span>\n         </span>\n        </section>\n        <section powered-by="werss">\n         <span style="font-size: 14.6667px;">\n          <span>\n           <span style="color: rgb(0, 0, 0);">\n            小米手机在春晚的投放比较克制，偶尔出现在节目中和开场前\n           </span>\n          </span>\n         </span>\n        </section>\n        <section powered-by="werss">\n         <span style="font-size: 14.6667px;">\n          <span>\n           <span style="color: rgb(0, 0, 0);">\n            Vivo也是另辟蹊径，曾拿下 “春晚新媒体直播技术合作伙伴”的身份。春晚后台的竖屏直播、花絮拍摄由vivo完成，展示其作为生产工具的强大能力\n           </span>\n          </span>\n         </span>\n        </section>\n        <section powered-by="werss">\n         <span style="font-size: 14.6667px;">\n          <span>\n           <span style="color: rgb(0, 0, 0);">\n            但巫师认为，春晚中的手机品牌传播效果中，最赚的，还是苹果，因为它是唯一一个，\n           </span>\n          </span>\n         </span>\n         <span style="color: rgb(255, 0, 0);font-size: 14.6667px;">\n          <span>\n           <span style="color: rgb(0, 0, 0);">\n            不花钱还办大事\n           </span>\n          </span>\n         </span>\n         <span style="font-size: 14.6667px;">\n          <span>\n           <span style="color: rgb(0, 0, 0);">\n            的案例\n           </span>\n          </span>\n         </span>\n        </section>\n        <section powered-by="werss">\n         <span style="font-size: 14.6667px;">\n          <span>\n           <span style="color: rgb(0, 0, 0);">\n            以2025年春晚的某个镜头为例，虽然台上是清一色的国产手机，但镜头扫过台下观众席时，不少明星，和并未在表演状态的主持人被拍到正在使用 iPhone 拍照发朋友圈。这种“台上工作，台下生活”的反差成为了年度热梗，让果粉狠狠爽到了，其实巫师以前很长一段时间也只认苹果，直到甲方在各种合作中，送了各种机型过来，巫师可以赌命担保，现在真的时代变了，以往的惯性思维在实际使用后，受到了巨大的冲击，其实苹果和国产旗舰，真的说不清孰优孰劣了，不分上下，巫师不是数码博主，不聊无聊的参数，但这个感受的冲击，绝无虚言\n           </span>\n          </span>\n         </span>\n        </section>\n        <section powered-by="werss">\n         <span style="font-size: 21.3333px;">\n          <span>\n           <span style="color: rgb(0, 0, 0);font-weight: bold;">\n            5G和超高清\n           </span>\n          </span>\n         </span>\n        </section>\n        <section powered-by="werss">\n         <span style="font-size: 14.6667px;">\n          <span>\n           <span style="color: rgb(0, 0, 0);">\n            在这个快速发展的10年中，中国还有个概念曾经零星霸占春晚的赚钱效应\n           </span>\n          </span>\n         </span>\n        </section>\n        <section powered-by="werss">\n         <span style="font-size: 14.6667px;">\n          <span>\n           <span style="color: rgb(0, 0, 0);">\n            很多人忽略了这个好玩的点，就是2020年春晚的\n           </span>\n          </span>\n         </span>\n         <span style="color: rgb(255, 0, 0);font-size: 14.6667px;">\n          <span>\n           <span style="color: rgb(0, 0, 0);">\n            5G和超高清\n           </span>\n          </span>\n         </span>\n        </section>\n        <section powered-by="werss">\n         <span style="font-size: 14.6667px;">\n          <span>\n           <span style="color: rgb(0, 0, 0);">\n            3G到4G 是“从0到1”，4G把大家从图文时代带入了视频时代\n           </span>\n          </span>\n         </span>\n        </section>\n        <section powered-by="werss">\n         <span style="font-size: 14.6667px;">\n          <span>\n           <span style="color: rgb(0, 0, 0);">\n            那4G到5G是什么呢，大家感觉不是1到100，也不是1.0到2.0，而是1到1.1\n           </span>\n          </span>\n         </span>\n        </section>\n        <section powered-by="werss">\n         <span style="font-size: 14.6667px;">\n          <span>\n           <span style="color: rgb(0, 0, 0);">\n            普通人的感受之所以“边际效应平平”，甚至觉得被忽悠了，\n           </span>\n          </span>\n         </span>\n         <span style="color: rgb(255, 0, 0);font-size: 14.6667px;">\n          <span>\n           <span style="color: rgb(0, 0, 0);">\n            是因为5G这把“屠龙刀”，发到每个人手里后，只能切水果，但又齁贵\n           </span>\n          </span>\n         </span>\n        </section>\n        <section powered-by="werss">\n         <span style="font-size: 14.6667px;">\n          <span>\n           <span style="color: rgb(0, 0, 0);">\n            5G在To B端的突破感受比 To C更显著\n           </span>\n          </span>\n         </span>\n        </section>\n        <section powered-by="werss">\n         <span style="font-size: 14.6667px;">\n          <span>\n           <span style="color: rgb(0, 0, 0);">\n            但当时相关概念也在春晚上被炒上了天， 2020春晚宣布将首次实现“\n           </span>\n          </span>\n         </span>\n         <span style="color: rgb(255, 0, 0);font-size: 14.6667px;">\n          <span>\n           <span style="color: rgb(0, 0, 0);">\n            5G+8K+VR\n           </span>\n          </span>\n         </span>\n         <span style="font-size: 14.6667px;">\n          <span>\n           <span style="color: rgb(0, 0, 0);">\n            ”的全流程制作和传输\n           </span>\n          </span>\n         </span>\n        </section>\n        <section powered-by="werss">\n         <span style="font-size: 14.6667px;">\n          <span>\n           <span style="color: rgb(0, 0, 0);">\n            当天受此影响，超高清视频概念股午后走强。下午多个个股直接封板\n           </span>\n          </span>\n         </span>\n        </section>\n        <section powered-by="werss">\n         <span style="font-size: 14.6667px;">\n          <span>\n           <span style="color: rgb(0, 0, 0);">\n            更有意思的来了，本来又是大炒一波的场景\n           </span>\n          </span>\n         </span>\n        </section>\n        <section powered-by="werss">\n         <span style="font-size: 14.6667px;">\n          <span>\n           <span style="color: rgb(0, 0, 0);">\n            但春节假期一结束，由于口罩持续恶化，A股遭遇了史诗级的“千股跌停” ，这时候炒家门以为天塌了，纷纷跑路，但事情再次反转，这些人\n           </span>\n          </span>\n         </span>\n         <span style="color: rgb(255, 0, 0);font-size: 14.6667px;">\n          <span>\n           <span style="color: rgb(0, 0, 0);">\n            再次踏空\n           </span>\n          </span>\n         </span>\n        </section>\n        <section powered-by="werss">\n         <span style="font-size: 14.6667px;">\n          <span>\n           <span style="color: rgb(0, 0, 0);">\n            暴跌之后，资本市场迅速反应过来一个新逻辑：大家都在家隔离了，这说明什么\n           </span>\n          </span>\n         </span>\n        </section>\n        <section powered-by="werss">\n         <span style="font-size: 14.6667px;">\n          <span>\n           <span style="color: rgb(0, 0, 0);">\n            既然不能出门，那对于视频娱乐、大屏电视、家庭影院的需求是不是反而爆发了？\n           </span>\n          </span>\n         </span>\n        </section>\n        <section powered-by="werss">\n         <span style="font-size: 14.6667px;">\n          <span>\n           <span style="color: rgb(0, 0, 0);">\n            既然要上网课、云办公，那大大利好视频传输技术的企业啊\n           </span>\n          </span>\n         </span>\n        </section>\n        <section powered-by="werss">\n         <span style="font-size: 14.6667px;">\n          <span>\n           <span style="color: rgb(0, 0, 0);">\n            然后这些企业又和\n           </span>\n          </span>\n         </span>\n         <span style="color: rgb(255, 0, 0);font-size: 14.6667px;">\n          <span>\n           <span style="color: rgb(0, 0, 0);">\n            宅经济、云办公\n           </span>\n          </span>\n         </span>\n         <span style="font-size: 14.6667px;">\n          <span>\n           <span style="color: rgb(0, 0, 0);">\n            等概念混在一起，再度起飞，就是这么抽象\n           </span>\n          </span>\n         </span>\n        </section>\n        <section powered-by="werss">\n         <span style="font-size: 21.3333px;">\n          <span>\n           <span style="color: rgb(0, 0, 0);font-weight: bold;">\n            白酒\n           </span>\n          </span>\n         </span>\n        </section>\n        <section powered-by="werss">\n         <span style="font-size: 14.6667px;">\n          <span>\n           <span style="color: rgb(0, 0, 0);">\n            再然后就是春晚的老朋友——白酒\n           </span>\n          </span>\n         </span>\n        </section>\n        <section powered-by="werss">\n         <span style="font-size: 14.6667px;">\n          <span>\n           <span style="color: rgb(0, 0, 0);">\n            在春晚这个舞台，本来已经奄奄一息的白酒却在2024-2026\n           </span>\n          </span>\n         </span>\n         <span style="color: rgb(255, 0, 0);font-size: 14.6667px;">\n          <span>\n           <span style="color: rgb(0, 0, 0);">\n            再次打赢复活赛\n           </span>\n          </span>\n         </span>\n        </section>\n        <section powered-by="werss">\n         <span style="font-size: 14.6667px;">\n          <span>\n           <span style="color: rgb(0, 0, 0);">\n            媒体常常利用年轻人不跟你玩了，白酒要死了这种论调来挑逗年轻人的优越感\n           </span>\n          </span>\n         </span>\n        </section>\n        <section powered-by="werss">\n         <span style="font-size: 14.6667px;">\n          <span>\n           <span style="color: rgb(0, 0, 0);">\n            巫师的评价是，实际上这是媒体们的一种煽动性的“\n           </span>\n          </span>\n         </span>\n         <span style="color: rgb(255, 0, 0);font-size: 14.6667px;">\n          <span>\n           <span style="color: rgb(0, 0, 0);">\n            精神行贿\n           </span>\n          </span>\n         </span>\n         <span style="font-size: 14.6667px;">\n          <span>\n           <span style="color: rgb(0, 0, 0);">\n            ”\n           </span>\n          </span>\n         </span>\n        </section>\n        <section powered-by="werss">\n         <span style="font-size: 14.6667px;">\n          <span>\n           <span style="color: rgb(0, 0, 0);">\n            白酒本质是经济周期、政商环境、主体意识、商务消费回归低调，尤其是以房地产/银行/工程基建为核心的初代政商驱动模式的萎缩\n           </span>\n          </span>\n         </span>\n        </section>\n        <section powered-by="werss">\n         <span style="font-size: 14.6667px;">\n          <span>\n           <span style="color: rgb(0, 0, 0);">\n            年轻人从来就不是白酒消费和收藏的主力，白酒市场主要受特定一批壮年男性群体影响，由于上述变化，这批人进入新周期后也做出了审慎的决策，虽然大家都笑称自己“老登”，但这是自嘲，这部分人\n           </span>\n          </span>\n         </span>\n         <span style="color: rgb(255, 0, 0);font-size: 14.6667px;">\n          <span>\n           <span style="color: rgb(0, 0, 0);">\n            只是老了，不是死了\n           </span>\n          </span>\n         </span>\n         <span style="font-size: 14.6667px;">\n          <span>\n           <span style="color: rgb(0, 0, 0);">\n            ，而且这批在中国经济腾飞大潮中中吃到蛋糕，或者仅仅是吃到蛋糕渣的人，只要没踩到阶级掉落三件套，兜里现金流都比大家想象中的要充裕，只是老登们越来越保守罢了\n           </span>\n          </span>\n         </span>\n        </section>\n        <section powered-by="werss">\n         <span style="font-size: 14.6667px;">\n          <span>\n           <span style="color: rgb(0, 0, 0);">\n            2003-2014是白酒在春晚最活跃的年份，其中最经典的战役包括以下几个\n           </span>\n          </span>\n         </span>\n        </section>\n        <section powered-by="werss">\n         <span style="font-size: 14.6667px;">\n          <span>\n           <span style="color: rgb(0, 0, 0);">\n            江苏洋河混改后领导班子借道央视掀起蓝色旋风，红花郎连续冠名"我最喜爱的春晚节目评选"，泸州老窖不断拿下“零点报时”等等等等，各种白酒品牌也都借央视东风，要么实现咖位的提升，要么实现销量的提升\n           </span>\n          </span>\n         </span>\n        </section>\n        <section powered-by="werss">\n         <span style="font-size: 14.6667px;">\n          <span>\n           <span style="color: rgb(0, 0, 0);">\n            但到了2014-2023的十年，相关限制政策出台，主体意识转型，这一时期没有赢家，白酒投放春晚的热情迅速降温\n           </span>\n          </span>\n         </span>\n        </section>\n        <section powered-by="werss">\n         <span style="font-size: 14.6667px;">\n          <span>\n           <span style="color: rgb(0, 0, 0);">\n            然而这段时间中，最“\n           </span>\n          </span>\n         </span>\n         <span style="color: rgb(255, 0, 0);font-size: 14.6667px;">\n          <span>\n           <span style="color: rgb(0, 0, 0);">\n            痴情\n           </span>\n          </span>\n         </span>\n         <span style="font-size: 14.6667px;">\n          <span>\n           <span style="color: rgb(0, 0, 0);">\n            ”的莫过于古井贡酒了。2016年开始，它连续11年特约赞助春晚，在刚刚巫师说的互联网巨头春晚干架的十年风云中，古井贡酒就一直默默地站在旁边当背景板\n           </span>\n          </span>\n         </span>\n        </section>\n        <section powered-by="werss">\n         <span style="font-size: 14.6667px;">\n          <span>\n           <span style="color: rgb(0, 0, 0);">\n            然而这种默默持续投入让古井贡酒2019年营收跨过百亿门槛，之后又仅用4年跻身到200亿俱乐部之列，古井贡酒从2016年赞助春晚开始，到2021年初的高点，股价从20元左右涨到了270元左右，\n           </span>\n          </span>\n         </span>\n         <span style="color: rgb(255, 0, 0);font-size: 14.6667px;">\n          <span>\n           <span style="color: rgb(0, 0, 0);">\n            别人贪婪我恐惧别人恐惧我坚持\n           </span>\n          </span>\n         </span>\n         <span style="font-size: 14.6667px;">\n          <span>\n           <span style="color: rgb(0, 0, 0);">\n            是说\n           </span>\n          </span>\n         </span>\n        </section>\n        <section powered-by="werss">\n         <span style="font-size: 14.6667px;">\n          <section powered-by="werss" style="display: inline-block;text-indent: 0px;">\n           <img src="https://mmbiz.qpic.cn/sz_mmbiz_jpg/hmkxKic9qKJEH1u1MgADiaB7KdMYRKORu7X9MpEc5MA2dShpicagITqkP86TBDOJk2ib8CHY560VL9AiaLAibBtSYGzbcI54iaYZsu73JAtdtokpAM/640?wx_fmt=other&amp;from=appmsg" style="left:0px;top:0px;width:100%;background-color:transparent;"/>\n          </section>\n         </span>\n        </section>\n        <section powered-by="werss">\n         <span style="font-size: 14.6667px;">\n          <span>\n           <span style="color: rgb(0, 0, 0);">\n            在春晚互联网大厂的十年战争中，白酒虽然沦为路人，但在2024年发生了一个转折，互联网大厂红包式微，但五粮液站了出来开始发红包\n           </span>\n          </span>\n         </span>\n        </section>\n        <section powered-by="werss">\n         <span style="font-size: 14.6667px;">\n          <span>\n           <span style="color: rgb(0, 0, 0);">\n            而在2024-2025，红花郎、五粮液、古井贡酒、洋河梦之蓝、劲酒、西凤酒等，又集体扎堆出现在春晚多个环节，而以前从来不愿意上春晚的茅台，这两年也和一众白酒品牌一起，出现在了春晚舞台上，比如2024它夹在9家白酒品牌中间，表现得非常“克制”\n           </span>\n          </span>\n         </span>\n        </section>\n        <section powered-by="werss">\n         <span style="font-size: 14.6667px;">\n          <span>\n           <span style="color: rgb(0, 0, 0);">\n            白酒企业集体重归春晚舞台背后是大家的去库存压力较大，品牌曝光是\n           </span>\n          </span>\n         </span>\n         <span style="color: rgb(255, 0, 0);font-size: 14.6667px;">\n          <span>\n           <span style="color: rgb(0, 0, 0);">\n            稳定渠道信心\n           </span>\n          </span>\n         </span>\n         <span style="font-size: 14.6667px;">\n          <span>\n           <span style="color: rgb(0, 0, 0);">\n            的重要手段，你们也看到我最近发过茅台啊古井贡酒啊等等白酒企业的商单，另一方面，事实上白酒是强现金流行业，头部酒企账上的现金非常充裕\n           </span>\n          </span>\n         </span>\n        </section>\n        <section powered-by="werss">\n         <span style="font-size: 21.3333px;">\n          <span>\n           <span style="color: rgb(0, 0, 0);font-weight: bold;">\n            带货\n           </span>\n          </span>\n         </span>\n        </section>\n        <section powered-by="werss">\n         <span style="font-size: 14.6667px;">\n          <span>\n           <span style="color: rgb(0, 0, 0);">\n            除了以上特定行业的【赚钱效应】，春晚这几十年始终贯穿如一的，就是各种\n           </span>\n          </span>\n         </span>\n         <span style="color: rgb(255, 0, 0);font-size: 14.6667px;">\n          <span>\n           <span style="color: rgb(0, 0, 0);">\n            离奇的带货能力\n           </span>\n          </span>\n         </span>\n         <span style="font-size: 14.6667px;">\n          <span>\n           <span style="color: rgb(0, 0, 0);">\n            ，从1983年首届的刘晓庆一件5港币的红衬衫被命名为"晓庆衫"，再到赵本山小品密集植入搜狐和国窖1573等、还有刘谦魔术的汇源果汁、再到近期的服装、配饰和道具，比如张小斐孔雀蓝大衣，售价超万元，播出后10分钟售罄，章若楠2024粉色开衫，同款售价超千元，也是播出后超360万人搜索，迅速售罄，李沁的汉服带动汉服淘宝店同类成交额至少翻了3倍，王菲树脂耳环被网友戏称"神似虾片"，电商平台关键词搜索指数飙升，再有2023年杨紫Max Mara红色大衣，2023年秦岚绿色开衫、2024年马丽白色大衣、2019李思思与2017董卿的口红，甚至2021年上汽通用五菱生产的“春晚红”定制口罩也在电商平台上卖爆了\n           </span>\n          </span>\n         </span>\n        </section>\n        <section powered-by="werss">\n         <span style="font-size: 14.6667px;">\n          <span>\n           <span style="color: rgb(0, 0, 0);">\n            案例不胜枚举，春晚舞台当之无愧的是隐形带货大舞台\n           </span>\n          </span>\n         </span>\n        </section>\n        <section powered-by="werss">\n         <span style="font-size: 14.6667px;">\n          <span>\n           <span style="color: rgb(0, 0, 0);">\n            机器人、AI、汽车、手机、白酒、食品饮料、刚刚说的各类带货，赞助，股价和赚钱效应，才是春晚的\n           </span>\n          </span>\n         </span>\n         <span style="color: rgb(255, 0, 0);font-size: 14.6667px;">\n          <span>\n           <span style="color: rgb(0, 0, 0);">\n            里世界\n           </span>\n          </span>\n         </span>\n        </section>\n        <section powered-by="werss">\n         <span style="font-size: 14.6667px;">\n          <span>\n           <span style="color: rgb(0, 0, 0);">\n            别人吐槽春晚的节目来展现自己的品味，而巫师这期则提供一个谈资，让大家从资本视角审视一个里世界的春晚\n           </span>\n          </span>\n         </span>\n        </section>\n        <section powered-by="werss">\n         <span style="font-size: 14.6667px;">\n          <span>\n           <span style="color: rgb(0, 0, 0);">\n            最后，巫师的春晚资本博弈有个特点，就是其他期视频你可能一个人观看，但这期可以和全家配着春晚一起看，新春之际，作为财经区博主的我按照惯例应该祝大家发财，但我想应该很多人祝大家暴富了，就不再重复，巫师就祝你们2027年再看我的春晚资本博弈的时候，坐在你身边的人——\n           </span>\n          </span>\n         </span>\n         <span style="color: rgb(255, 0, 0);font-size: 14.6667px;">\n          <span>\n           <span style="color: rgb(0, 0, 0);">\n            只多不少\n           </span>\n          </span>\n         </span>\n         <span style="font-size: 14.6667px;">\n          <span>\n           <span style="color: rgb(0, 0, 0);">\n            ，并且，\n           </span>\n          </span>\n         </span>\n         <span style="color: rgb(255, 0, 0);font-size: 14.6667px;">\n          <span>\n           <span style="color: rgb(0, 0, 0);">\n            平安健康\n           </span>\n          </span>\n         </span>\n        </section>\n        <section powered-by="werss">\n         <span style="font-size: 14.6667px;">\n          <span>\n           <span style="color: rgb(0, 0, 0);">\n            Ok。文案数据图表自取，点个关注随便用，就说是你写的\n           </span>\n          </span>\n         </span>\n        </section>\n        <section powered-by="werss">\n         <span style="font-size: 14.6667px;">\n          <span>\n           <span style="color: rgb(0, 0, 0);">\n            资本永不眠，下期见\n           </span>\n          </span>\n         </span>\n         <span style="font-size: 14.6667px;">\n         </span>\n        </section>\n        <section powered-by="werss">\n         <span>\n          <br/>\n         </span>\n        </section>\n        <p style="display: none;">\n         <mp-style-type data-value="3">\n         </mp-style-type>\n        </p>\n       </div>\n       <script nonce="719064299" reportloaderror="" type="text/javascript">\n        var first_sceen__time = (+new Date());\n            if ("" == 1 && document.getElementById(\'js_content\')) {\n              document.getElementById(\'js_content\').addEventListener("selectstart",function(e){ e.preventDefault(); });\n            }\n       </script>\n      </div>\n      <div class="article-tag__error-tips" id="js_tags_preview_toast" style="display: none;">\n       预览时标签不可点\n      </div>\n      <div id="content_bottom_area">\n      </div>\n      <div id="font_pannel_area">\n      </div>\n      <div class="rich_media_tool_area" id="js_temp_bottom_area">\n       <div class="rich_media_tool__wrp">\n        <div class="rich_media_tool">\n         <div class="rich_media_info weui-flex">\n         </div>\n        </div>\n       </div>\n      </div>\n     </div>\n    </div>\n    <div class="rich_media_area_primary sougou" id="sg_tj" style="display:none">\n    </div>\n    <div class="rich_media_area_extra">\n     <div class="rich_media_area_extra_inner">\n      <div id="page_bottom_area">\n      </div>\n     </div>\n    </div>\n    <div class="qr_code_pc_outer" id="js_pc_qr_code" style="display:none;">\n     <div class="qr_code_pc_inner">\n      <div class="qr_code_pc">\n       <img/>\n       <p>\n        微信扫一扫\n        <br/>\n        关注该公众号\n       </p>\n      </div>\n     </div>\n    </div>\n   </div>\n   <div class="wx_stream_article_slide_tip" id="wx_stream_article_slide_tip">\n    <div class="wx_stream_article_slide_tip_wrp">\n     <span>\n     </span>\n     <span>\n      继续滑动看下一个\n     </span>\n    </div>\n   </div>\n  </div>\n  <div class="wx_network_msg_wrp" id="js_network_msg_wrp">\n  </div>\n  <div class="wx_expand_article" id="wx_expand_article">\n   <div class="wx_expand_article_gradient_background" id="wx_expand_background">\n   </div>\n   <div class="wx_expand_article_bottom_area" id="wx_expand_bottom">\n    <div class="wx_expand_article_button_wrap" id="wx_expand_article_placeholder">\n     <button class="wx_expand_article_button" id="wx_expand_article_button">\n      轻触阅读原文\n     </button>\n    </div>\n    <div class="stream_bottom_bar_wrp" id="js_stream_bottom_bar">\n     <div class="bottom_bar_placeholder" id="js_stream_bottom_bar_placeholder">\n      <div class="wx_follow_context wx_follow_primary wx_follow_smart wx_follow_top wx_follow_bottom">\n       <div class="function_mod js_function_mod wx_tap_cell">\n        <div class="function_mod_inner js_function_mod_inner">\n         <div class="function_bd">\n          <div class="wx_follow_media weui-flex weui-flex_align-center">\n           <div class="wx_follow_hd">\n            <span>\n             <img src="http://mmbiz.qpic.cn/mmbiz_png/A5AZPRIiakEIhcjXobvFF8FDDoabQibiaMTW3LBXK5VD5ciaKeWYxQia4GxOHv8v6WJUkZwetGNGvWtUoanWNTuIgMQ/0?wx_fmt=png">\n             </img>\n            </span>\n           </div>\n           <div class="wx_follow_bd weui-flex__item">\n            