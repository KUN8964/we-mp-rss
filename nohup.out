[SQL] SELECT articles.id AS articles_id, articles.mp_id AS articles_mp_id, articles.title AS articles_title, articles.pic_url AS articles_pic_url, articles.url AS articles_url, articles.description AS articles_description, articles.extinfo AS articles_extinfo, articles.status AS articles_status, articles.publish_time AS articles_publish_time, articles.create_time AS articles_create_time, articles.publish_type AS articles_publish_type, articles.publish_src AS articles_publish_src, articles.publish_status AS articles_publish_status, articles.art_type AS articles_art_type, articles.show_type AS articles_show_type, articles.publish_info AS articles_publish_info, articles.original_check_type AS articles_original_check_type, articles.in_profile AS articles_in_profile, articles.pre_publish_status AS articles_pre_publish_status, articles.service_type AS articles_service_type, articles.item_show_type AS articles_item_show_type, articles.copyright_stat AS articles_copyright_stat, articles.has_red_packet_cover AS articles_has_red_packet_cover, articles.created_at AS articles_created_at, articles.updated_at AS articles_updated_at, articles.updated_at_millis AS articles_updated_at_millis, articles.is_export AS articles_is_export, articles.is_read AS articles_is_read, articles.is_favorite AS articles_is_favorite, articles.fix_fail_count AS articles_fix_fail_count, articles.has_content AS articles_has_content, articles.content AS articles_content, articles.content_html AS articles_content_html 
