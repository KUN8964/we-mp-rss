se.resolve();\n    }\n  })();\n  </script>\n  <script nonce="487950976" reportloaderror="">\n   var page_begintime = (+new Date());\nvar is_rumor = "";\nvar norumor = "";\nvar refutationType = \'\' * 1;\nif (!!(is_rumor * 1) && !(norumor*1) && !!biz && !!mid) {\n  if (!document.referrer || document.referrer.indexOf("mp.weixin.qq.com/mp/rumor") == -1){\n    if (refutationType === 1) {\n      location.href = "http://mp.weixin.qq.com/mp/show_refutation?__biz=" + biz + "&mid=" + mid + "&idx=" + idx + "&sn=" + sn + "#wechat_redirect";\n    } else {\n      location.href = "http://mp.weixin.qq.com/mp/rumor?action=info&__biz=" + biz + "&mid=" + mid + "&idx=" + idx + "&sn=" + sn + "#wechat_redirect";\n    }\n  }\n}\n  </script>\n  <script h5only="" nonce="487950976" reportloaderror="" type="text/javascript">\n   (function() {\n    try {\n      window.cgiDataNew = {\n                  base_resp: {\n                           ret: \'0\' * 1,\n                                      errmsg: \'ok\',\n                                      wxtoken: \'777\' * 1,\n                                      cookie_count: \'0\' * 1,\n                                                              sessionid: \'svr_7992117a02d\',\n                                                          },\n                          user_name: \'gh_882801da76f4\',\n                          nick_name: \'巫师财经\',\n                          round_head_img: \'http://mmbiz.qpic.cn/mmbiz_png/A5AZPRIiakEIhcjXobvFF8FDDoabQibiaMTW3LBXK5VD5ciaKeWYxQia4GxOHv8v6WJUkZwetGNGvWtUoanWNTuIgMQ/0?wx_fmt=png\',\n                          title: \'【巫师】美国干伊朗02，藏着对我们的资本阴招儿\',\n                          desc: \'\',\n                          content_noencode: \'\\x3csection data-mpa-action-id=\\x22mmdc9lwi1408\\x22 data-pm-slice=\\x220 0 []\\x22\\x3e\\x3cspan style=\\x22font-size: 14.6667px;\\x22\\x3e\\x3c/span\\x3e\\x3cspan style=\\x22font-size: 14.6667px;\\x22\\x3e\\x3cspan leaf=\\x22\\x22\\x3e大家好我是巫师\\x3c/span\\x3e\\x3c/span\\x3e\\x3c/section\\x3e\\x3csection data-mpa-action-id=\\x22mmdc9lwi1kgb\\x22\\x3e\\x3cspan style=\\x22font-size: 14.6667px;\\x22\\x3e\\x3cspan leaf=\\x22\\x22\\x3e最近研究半天发现，坏了，美国打伊朗，不会是冲着我们来的吧，因为藏了不少对我们的资本阴招，之前对面的颜色革命的洗脑战，科技战，贸易战，这些美国正面对华战争全都走进了死胡同，对方似乎想换个姿势，用更隐秘更阴险的姿势，对中国的伤害以\\x22战争附带效果\\x22的形式出现，避免了正面硬碰的成本\\x3c/span\\x3e\\x3c/span\\x3e\\x3c/section\\x3e\\x3csection data-mpa-action-id=\\x22mmdc9lwi13w3\\x22\\x3e\\x3cspan style=\\x22font-size: 21.3333px;\\x22\\x3e\\x3cspan leaf=\\x22\\x22\\x3e\\x3cspan textstyle=\\x22\\x22 style=\\x22font-weight: bold;\\x22\\x3e第一层\\x3c/span\\x3e\\x3c/span\\x3e\\x3c/span\\x3e\\x3c/section\\x3e\\x3csection data-mpa-action-id=\\x22mmdc9lwi1ri1\\x22\\x3e\\x3cspan style=\\x22font-size: 14.6667px;\\x22\\x3e\\x3cspan leaf=\\x22\\x22\\x3e先说第一层\\x3c/span\\x3e\\x3c/span\\x3e\\x3c/section\\x3e\\x3csection data-mpa-action-id=\\x22mmdc9lwi1l5v\\x22\\x3e\\x3cspan style=\\x22font-size: 14.6667px;\\x22\\x3e\\x3cspan leaf=\\x22\\x22\\x3e明面上五大石油供应国为俄罗斯、沙特、马来西亚、伊拉克和巴西，没伊朗\\x3c/span\\x3e\\x3c/span\\x3e\\x3c/section\\x3e\\x3csection data-mpa-action-id=\\x22mmdc9lwi1bxq\\x22\\x3e\\x3cspan style=\\x22font-size: 14.6667px;\\x22\\x3e\\x3cspan leaf=\\x22\\x22\\x3e但事实上呢，直接上表，你们随便用，就说你做的\\x3c/span\\x3e\\x3c/span\\x3e\\x3c/section\\x3e\\x3csection data-mpa-action-id=\\x22mmdc9lwitga\\x22\\x3e\\x3cspan style=\\x22font-size: 14.6667px;\\x22\\x3e\\x3csection style=\\x22display: inline-block;text-indent: 0px;\\x22 nodeleaf=\\x22\\x22\\x3e\\x3cimg class=\\x22rich_pages wxw-img\\x22 data-aistatus=\\x221\\x22 data-backh=\\x22324\\x22 data-backw=\\x22577\\x22 data-imgfileid=\\x22100002981\\x22 data-ratio=\\x221\\x22 data-src=\\x22https://mmbiz.qpic.cn/mmbiz_jpg/hmkxKic9qKJG4iaedPHf2UU5SAEmpBS99ia06sseb9lDPv6jgoPIAguYe80a3PiaOmAqkHxKFRnfsicpxMibl3QHPuSG15452NtJfqCYlOOnLlyM0/640?wx_fmt=other\\x26amp;from=appmsg\\x22 data-type=\\x22webp\\x22 data-w=\\x221000\\x22 style=\\x22left:0px;top:0px;width:100%;background-color:transparent;\\x22\\x3e\\x3c/section\\x3e\\x3c/span\\x3e\\x3c/section\\x3e\\x3csection data-mpa-action-id=\\x22mmdc9lwi1jrt\\x22\\x3e\\x3cspan style=\\x22font-size: 14.6667px;\\x22\\x3e\\x3cspan leaf=\\x22\\x22\\x3e伊朗油有一套精密的\\x22换标\\x22体系，尤其是以马来西亚，这个最大的\\x22洗油\\x22中心为主，还有印尼这个新兴的洗油通道，那没有官方数据怎么办呢，巫师把油轮追踪数据全部下载下来，把2025的伊朗实际供油量还原，可以看到伊朗排到了第三或者第四，大概占12%，数据源和我的推测依据都在里面了\\x3c/span\\x3e\\x3c/span\\x3e\\x3c/section\\x3e\\x3csection data-mpa-action-id=\\x22mmdc9lwi1lnk\\x22\\x3e\\x3cspan style=\\x22font-size: 14.6667px;\\x22\\x3e\\x3csection style=\\x22display: inline-block;text-indent: 0px;\\x22 nodeleaf=\\x22\\x22\\x3e\\x3cimg class=\\x22rich_pages wxw-img\\x22 data-aistatus=\\x221\\x22 data-backh=\\x22324\\x22 data-backw=\\x22577\\x22 data-imgfileid=\\x22100002982\\x22 data-ratio=\\x221\\x22 data-src=\\x22https://mmbiz.qpic.cn/mmbiz_jpg/hmkxKic9qKJFBgg5L5omSxlIjNL4rcQibFdQIFTCdYyLQ62YFz0c4FlU8MsTicrmVHd1aMiaWpeicfhhbtSGhictuWBRrXJkQ7bQRVPeKdM5ia5Cqg/640?wx_fmt=other\\x26amp;from=appmsg\\x22 data-type=\\x22webp\\x22 data-w=\\x221000\\x22 style=\\x22left:0px;top:0px;width:100%;background-color:transparent;\\x22\\x3e\\x3c/section\\x3e\\x3c/span\\x3e\\x3c/section\\x3e\\x3csection data-mpa-action-id=\\x22mmdc9lwi12gx\\x22\\x3e\\x3cspan style=\\x22font-size: 14.6667px;\\x22\\x3e\\x3cspan leaf=\\x22\\x22\\x3e上期我说没进前五，这里勘误一下，只是我国长期以来的能源安全战略，其实就是为了防止这种事发生，就是不能太依赖某一个国家的石油\\x26nbsp;\\x3c/span\\x3e\\x3c/span\\x3e\\x3c/section\\x3e\\x3csection data-mpa-action-id=\\x22mmdc9lwiqpz\\x22\\x3e\\x3cspan style=\\x22font-size: 14.6667px;\\x22\\x3e\\x3cspan leaf=\\x22\\x22\\x3e美国打伊朗的附带效果是，霍尔木兹海峡是封锁了全球30%的海运石油\\x3c/span\\x3e\\x3c/span\\x3e\\x3c/section\\x3e\\x3csection data-mpa-action-id=\\x22mmdc9lwi15gf\\x22\\x3e\\x3cspan style=\\x22font-size: 14.6667px;\\x22\\x3e\\x3csection style=\\x22display: inline-block;text-indent: 0px;\\x22 nodeleaf=\\x22\\x22\\x3e\\x3cimg class=\\x22rich_pages wxw-img\\x22 data-aistatus=\\x221\\x22 data-backh=\\x22324\\x22 data-backw=\\x22577\\x22 data-imgfileid=\\x22100002979\\x22 data-ratio=\\x221\\x22 data-src=\\x22https://mmbiz.qpic.cn/mmbiz_jpg/hmkxKic9qKJHicVgiaVJ9ibwTAgic5hEnqQ7d439K9JN0IzJhJzCYqH5hCbnek5cteGVKnMN9N39AX7CQs76pabXE0ZVmkPq7fIDNhXfvWTbjp4g/640?wx_fmt=other\\x26amp;from=appmsg\\x22 data-type=\\x22webp\\x22 data-w=\\x221000\\x22 style=\\x22left:0px;top:0px;width:100%;background-color:transparent;\\x22\\x3e\\x3c/section\\x3e\\x3c/span\\x3e\\x3c/section\\x3e\\x3csection data-mpa-action-id=\\x22mmdc9lwi3ui\\x22\\x3e\\x3cspan style=\\x22font-size: 14.6667px;\\x22\\x3e\\x3cspan leaf=\\x22\\x22\\x3e巫师把我的研究逻辑展开，你们吹逼的时候可以直接用，巫师把这些给中国的油分了四档\\x3c/span\\x3e\\x3c/span\\x3e\\x3c/section\\x3e\\x3csection data-mpa-action-id=\\x22mmdc9lwi21ds\\x22\\x3e\\x3cspan style=\\x22font-size: 14.6667px;\\x22\\x3e\\x3cspan leaf=\\x22\\x22\\x3e第一档是扎扎实实的封上了，伊朗，科威特，卡塔尔的油就是这一挡，这些油占中国进口的15-17%\\x3c/span\\x3e\\x3c/span\\x3e\\x3c/section\\x3e\\x3csection data-mpa-action-id=\\x22mmdc9lwig7u\\x22\\x3e\\x3cspan style=\\x22font-size: 14.6667px;\\x22\\x3e\\x3cspan leaf=\\x22\\x22\\x3e第二档是重度依赖霍尔木兹，仅有极少绕行能力，代表国就是伊拉克，伊拉克对华出口中的90%受影响，剩下10%能迂回运到中国，但运距长、运费高，实际到货量可能更少，这一档约100-110万桶/日实际断供\\x3c/span\\x3e\\x3c/span\\x3e\\x3c/section\\x3e\\x3csection data-mpa-action-id=\\x22mmdc9lwi1e17\\x22\\x3e\\x3cspan style=\\x22font-size: 14.6667px;\\x22\\x3e\\x3cspan leaf=\\x22\\x22\\x3e第三档是有绕行替代，但远不足以替代海运量，沙特阿拉伯就是其中代表，沙特理论上可以绕行，但受胡塞武装影响，其绕行能力可能被高估，而且沙特出口全球的油都要想办法绕行，也不能光卖给我们，这一档合计75-100万桶/日实际断供\\x3c/span\\x3e\\x3c/span\\x3e\\x3c/section\\x3e\\x3csection data-mpa-action-id=\\x22mmdc9lwi14u0\\x22\\x3e\\x3cspan style=\\x22font-size: 14.6667px;\\x22\\x3e\\x3cspan leaf=\\x22\\x22\\x3e第四档就是完全不受霍尔木兹影响，俄罗斯，巴西，委内瑞拉，安哥拉/西非等，所以结论给你们一个表\\x3c/span\\x3e\\x3c/span\\x3e\\x3c/section\\x3e\\x3csection data-mpa-action-id=\\x22mmdc9lwi1f1p\\x22\\x3e\\x3cspan style=\\x22font-size: 14.6667px;\\x22\\x3e\\x3cspan leaf=\\x22\\x22\\x3e巫师算的实际断供占中国总进口的35%，当然这个表是巫师的慌忙的dirty work，不精确，而且局势还在变，但巫师想到怎么交叉验证了\\x3c/span\\x3e\\x3c/span\\x3e\\x3c/section\\x3e\\x3csection data-mpa-action-id=\\x22mmdc9lwizsz\\x22\\x3e\\x3cspan style=\\x22font-size: 14.6667px;\\x22\\x3e\\x3csection style=\\x22display: inline-block;text-indent: 0px;\\x22 nodeleaf=\\x22\\x22\\x3e\\x3cimg class=\\x22rich_pages wxw-img\\x22 data-aistatus=\\x221\\x22 data-backh=\\x22324\\x22 data-backw=\\x22577\\x22 data-imgfileid=\\x22100002978\\x22 data-ratio=\\x221\\x22 data-src=\\x22https://mmbiz.qpic.cn/mmbiz_jpg/hmkxKic9qKJHQmibKiaWIRYmKZ3pDzfXdJZ9x93JiaAfdCFoD3hHbB2iaYAX4wrS5FTU1egJpECaWCuYMkicAwrm5eKZnEv19s2WV7mCXMypAbg1E/640?wx_fmt=other\\x26amp;from=appmsg\\x22 data-type=\\x22webp\\x22 data-w=\\x221000\\x22 style=\\x22left:0px;top:0px;width:100%;background-color:transparent;\\x22\\x3e\\x3c/section\\x3e\\x3c/span\\x3e\\x3c/section\\x3e\\x3csection data-mpa-action-id=\\x22mmdc9lwi117b\\x22\\x3e\\x3cspan style=\\x22font-size: 14.6667px;\\x22\\x3e\\x3cspan leaf=\\x22\\x22\\x3e翻了翻Kpler的报告，Kpler早期曾经说过40%的中国石油进口经霍尔木兹海峡，巫师现在算的是35%，大差不差吧，你们凑合用\\x3c/span\\x3e\\x3c/span\\x3e\\x3c/section\\x3e\\x3csection data-mpa-action-id=\\x22mmdc9lwi223e\\x22\\x3e\\x3cspan style=\\x22font-size: 14.6667px;\\x22\\x3e\\x3cspan leaf=\\x22\\x22\\x3e这是第一层\\x3c/span\\x3e\\x3c/span\\x3e\\x3c/section\\x3e\\x3csection data-mpa-action-id=\\x22mmdc9lwi2m7\\x22\\x3e\\x3cspan style=\\x22font-size: 21.3333px;\\x22\\x3e\\x3cspan leaf=\\x22\\x22\\x3e\\x3cspan textstyle=\\x22\\x22 style=\\x22font-weight: bold;\\x22\\x3e第二层\\x3c/span\\x3e\\x3c/span\\x3e\\x3c/span\\x3e\\x3c/section\\x3e\\x3csection data-mpa-action-id=\\x22mmdc9lwi130g\\x22\\x3e\\x3cspan style=\\x22font-size: 14.6667px;\\x22\\x3e\\x3cspan leaf=\\x22\\x22\\x3e第二层来了\\x3c/span\\x3e\\x3c/span\\x3e\\x3c/section\\x3e\\x3csection data-mpa-action-id=\\x22mmdc9lwi1tth\\x22\\x3e\\x3cspan style=\\x22font-size: 14.6667px;\\x22\\x3e\\x3cspan leaf=\\x22\\x22\\x3e美国眼里的中国，就是个巨型肥肉。以前的颜色革命，现在的关税战、科技战，本质上是正面强攻，结果打了这么多年，舆论洗脑失败，意林和公知全部进了版本下水道，科技芯片封锁，AI封锁，反而逼出国产替代产业链和Deepseek时刻，对华贸易战更是搞笑，逆差没收窄，中国在外贸上还在框框赚钱，2025年度咱们创造了1.19万亿美元的顺差，在各种不利因素下，创造了人类经济史上的奇迹，这是人类有经济记录以来，第一个货物贸易顺差突破1万亿美元的国家\\x3c/span\\x3e\\x3c/span\\x3e\\x3c/section\\x3e\\x3csection data-mpa-action-id=\\x22mmdc9lwi7ky\\x22\\x3e\\x3cspan style=\\x22font-size: 14.6667px;\\x22\\x3e\\x3csection style=\\x22display: inline-block;text-indent: 0px;\\x22 nodeleaf=\\x22\\x22\\x3e\\x3cimg class=\\x22rich_pages wxw-img\\x22 data-aistatus=\\x221\\x22 data-backh=\\x22324\\x22 data-backw=\\x22577\\x22 data-imgfileid=\\x22100002980\\x22 data-ratio=\\x221\\x22 data-src=\\x22https://mmbiz.qpic.cn/mmbiz_jpg/hmkxKic9qKJHsfVBlphpkGRI2oh6QWpk2jx4hURhsUTXDH5T3E4nzMIOC0diafHwGJPoDJGicbFoicPKTcTSK84Y2draBjnw9lzNWOlUUxh0ljI/640?wx_fmt=other\\x26amp;from=appmsg\\x22 data-type=\\x22webp\\x22 data-w=\\x221000\\x22 style=\\x22left:0px;top:0px;width:100%;background-color:transparent;\\x22\\x3e\\x3c/section\\x3e\\x3c/span\\x3e\\x3c/section\\x3e\\x3csection data-mpa-action-id=\\x22mmdc9lwi16pn\\x22\\x3e\\x3cspan style=\\x22font-size: 14.6667px;\\x22\\x3e\\x3cspan leaf=\\x22\\x22\\x3e洗脑战，科技战，贸易战，这些正面收割全都走进了死胡同，那就换个姿势，改打我们的工业链，其中的关键就是石油和相关化工原料，毕竟咱们在能源上确实是个短板，对外依赖很高\\x3c/span\\x3e\\x3c/span\\x3e\\x3c/section\\x3e\\x3csection data-mpa-action-id=\\x22mmdc9lwidum\\x22\\x3e\\x3cspan style=\\x22font-size: 14.6667px;\\x22\\x3e\\x3cspan leaf=\\x22\\x22\\x3e上期我测算过，油价对老百姓CPI的影响虽然小，但对工厂的生产成本（PPI）影响大，传导系数大约7.4%，而且如果后续涨到100甚至120美元一桶，PPI还会被推高2-3个百分点\\x3c/span\\x3e\\x3c/span\\x3e\\x3c/section\\x3e\\x3csection data-mpa-action-id=\\x22mmdc9lwi7tn\\x22\\x3e\\x3cspan style=\\x22font-size: 14.6667px;\\x22\\x3e\\x3csection style=\\x22display: inline-block;text-indent: 0px;\\x22 nodeleaf=\\x22\\x22\\x3e\\x3cimg class=\\x22rich_pages wxw-img\\x22 data-aistatus=\\x221\\x22 data-backh=\\x22324\\x22 data-backw=\\x22577\\x22 data-imgfileid=\\x22100002985\\x22 data-ratio=\\x221\\x22 data-src=\\x22https://mmbiz.qpic.cn/mmbiz_jpg/hmkxKic9qKJHQgbBM7ic2QQU01nycpicTyW6iaoObjgnhVD9f3R0SO02bibOBsUPQB4u89nEnqicVorKphY7AymI8dXIKMMvOsT5IPXwmxOIJAhmQ/640?wx_fmt=other\\x26amp;from=appmsg\\x22 data-type=\\x22webp\\x22 data-w=\\x221000\\x22 style=\\x22left:0px;top:0px;width:100%;background-color:transparent;\\x22\\x3e\\x3c/section\\x3e\\x3c/span\\x3e\\x3c/section\\x3e\\x3csection data-mpa-action-id=\\x22mmdc9lwiz6e\\x22\\x3e\\x3cspan style=\\x22font-size: 14.6667px;\\x22\\x3e\\x3cspan leaf=\\x22\\x22\\x3e上期视频我为什么展示纯苯2604苯乙烯2604等等的价格，很多人不明白，因为还有大量的化工原料的出口被封锁的效用被低估了，中国是这些东西的最大消费国\\x3c/span\\x3e\\x3c/span\\x3e\\x3c/section\\x3e\\x3csection data-mpa-action-id=\\x22mmdc9lwihro\\x22\\x3e\\x3cspan style=\\x22font-size: 14.6667px;\\x22\\x3e\\x3cspan leaf=\\x22\\x22\\x3e打开化工商品的交易面板， 先是甲醇，中东地区甲醇占中国进口的60%以上，其次是乙苯，就是做苯乙烯的。再有就是纯苯，化工界的\\x22面粉\\x22，拿它可以做出一大堆东西：染料、塑料、橡胶、药品、洗涤剂，中国是全球最大纯苯消费国，\\x3c/span\\x3e\\x3c/span\\x3e\\x3cspan style=\\x22font-size: 14.6667px;\\x22\\x3e\\x3cspan leaf=\\x22\\x22\\x3e\\x26nbsp;\\x3c/span\\x3e\\x3c/span\\x3e\\x3cspan style=\\x22font-size: 14.6667px;\\x22\\x3e\\x3cspan leaf=\\x22\\x22\\x3e再有PX，做PTA，最终变成涤纶，也就是你身上穿的衣服\\x3c/span\\x3e\\x3c/span\\x3e\\x3c/section\\x3e\\x3csection data-mpa-action-id=\\x22mmdc9lwi1t71\\x22\\x3e\\x3cspan style=\\x22font-size: 14.6667px;\\x22\\x3e\\x3cspan leaf=\\x22\\x22\\x3e再有PE，聚乙烯，全世界用量最大的塑料，没有之一。塑料袋、保鲜膜、水管，PE我国每年进口量千万吨级别，我们来源主要是沙特、伊朗、阿联酋和东南亚\\x3c/span\\x3e\\x3c/span\\x3e\\x3c/section\\x3e\\x3csection data-mpa-action-id=\\x22mmdc9lwi1rmk\\x22\\x3e\\x3cspan style=\\x22font-size: 14.6667px;\\x22\\x3e\\x3cspan leaf=\\x22\\x22\\x3e再有，LPG，就是液化石油气，阿联酋、沙特、卡塔尔是主要来源\\x3c/span\\x3e\\x3c/span\\x3e\\x3c/section\\x3e\\x3csection data-mpa-action-id=\\x22mmdc9lwi193p\\x22\\x3e\\x3cspan style=\\x22font-size: 14.6667px;\\x22\\x3e\\x3cspan leaf=\\x22\\x22\\x3e再有，乙二醇，一是做涤纶，跟PTA配合，二是做防冻液，中国是全球最大进口国，沙特是头号供应商\\x3c/span\\x3e\\x3c/span\\x3e\\x3c/section\\x3e\\x3csection data-mpa-action-id=\\x22mmdc9lwi1psw\\x22\\x3e\\x3cspan style=\\x22font-size: 14.6667px;\\x22\\x3e\\x3cspan leaf=\\x22\\x22\\x3e所以这一系列东西涨价，最终会影响我们这个工业克苏鲁，但你以为这就完了么\\x3c/span\\x3e\\x3c/span\\x3e\\x3c/section\\x3e\\x3csection data-mpa-action-id=\\x22mmdc9lwi1ehc\\x22\\x3e\\x3cspan style=\\x22font-size: 21.3333px;\\x22\\x3e\\x3cspan leaf=\\x22\\x22\\x3e\\x3cspan textstyle=\\x22\\x22 style=\\x22font-weight: bold;\\x22\\x3e第三层\\x3c/span\\x3e\\x3c/span\\x3e\\x3c/span\\x3e\\x3c/section\\x3e\\x3csection data-mpa-action-id=\\x22mmdc9lwilaq\\x22\\x3e\\x3cspan style=\\x22font-size: 14.6667px;\\x22\\x3e\\x3cspan leaf=\\x22\\x22\\x3e我开头\\x22马来西亚\\x22这个第三名实际上是个壳，如果把中国从马来西亚进口量，减去马来西亚自己的产油量，大家以为剩下的部分就是伊朗了，但巫师告诉你不只是伊朗，还有委内瑞拉\\x3c/span\\x3e\\x3c/span\\x3e\\x3c/section\\x3e\\x3csection data-mpa-action-id=\\x22mmdc9lwixq9\\x22\\x3e\\x3cspan style=\\x22font-size: 14.6667px;\\x22\\x3e\\x3cspan leaf=\\x22\\x22\\x3e还记得牢美刚刚干过什么事儿吧，之前牢美干委内瑞拉，现在牢美干伊朗，Trump疯疯癫癫，到处瞎出招，但还真波及到了我们\\x26nbsp;\\x3c/span\\x3e\\x3c/span\\x3e\\x3c/section\\x3e\\x3csection data-mpa-action-id=\\x22mmdc9lwi1sj5\\x22\\x3e\\x3cspan style=\\x22font-size: 14.6667px;\\x22\\x3e\\x3cspan leaf=\\x22\\x22\\x3e制裁收紧、海上拦截加码，然后战争和封锁，伊朗加委内瑞拉一起清零，我们少了15-18%的原油来源和大幅的甲醇缺口，还有无数上述化工原料的进口受阻\\x3c/span\\x3e\\x3c/span\\x3e\\x3c/section\\x3e\\x3csection data-mpa-action-id=\\x22mmdc9lwi23tw\\x22\\x3e\\x3cspan style=\\x22font-size: 14.6667px;\\x22\\x3e\\x3cspan leaf=\\x22\\x22\\x3e再下一步攥住咽喉。霍尔木兹、马六甲、苏伊士、巴拿马、好望角，都能投射力量，而红海-曼德海峡已经因胡塞武装常态化骚扰而半瘫痪，只需要\\x22选择性反恐\\x22就能控制通行节奏；而且巴拿马运河的主权争议已经被Trump公开提上台面；马六甲海峡周边，美国在新加坡、菲律宾、印尼都有军事存在或准入协议\\x3c/span\\x3e\\x3c/span\\x3e\\x3c/section\\x3e\\x3csection data-mpa-action-id=\\x22mmdc9lwi13zg\\x22\\x3e\\x3cspan style=\\x22font-size: 14.6667px;\\x22\\x3e\\x3cspan leaf=\\x22\\x22\\x3e不需要同时封锁所有通道。只需要让每条通道都处于\\x22可能被卡\\x22的不确定状态，甚至五角大楼为了自己贪点钱，主动搞点局部摩擦，别的不说，航运保险费率就会系统性上浮，而且相应的原油和化工附属品价格都会波动，中国的贸易成本就会在持续失血\\x3c/span\\x3e\\x3c/span\\x3e\\x3c/section\\x3e\\x3csection data-mpa-action-id=\\x22mmdc9lwikmo\\x22\\x3e\\x3cspan style=\\x22font-size: 14.6667px;\\x22\\x3e\\x3cspan leaf=\\x22\\x22\\x3e当然，中国除了从海上进口原油和化工品，还有咱们这个邻居，俄罗斯是个变量。俄罗斯是中国第一大供应国。但俄罗斯的心眼很多，他们最期盼着中国和美国狠狠干一架，而且巫师想说，越跟我们掰扯利益的国家，事实上我们从中收益越多。反而天天越跟我们喊口号喊友谊的国家，他们从我们这儿捞的利益越多，要防着俄罗斯把我们当成筹码卖给美国，很多人会反驳，但我更倾向于俄罗斯的终极利益是恢复欧洲市场的利益，中国市场是制裁时期的替代方案而非首选。我们就是个备胎罢了，等他的欧美白月光又开始吊着他了，你看他舔不舔就完事了，一个热知识——他以前可没少舔\\x3c/span\\x3e\\x3c/span\\x3e\\x3c/section\\x3e\\x3csection data-mpa-action-id=\\x22mmdc9lwi1ixp\\x22\\x3e\\x3cspan style=\\x22font-size: 14.6667px;\\x22\\x3e\\x3cspan leaf=\\x22\\x22\\x3e当能源和化工贸易路线风险波动，我们就有点难受，作为世界第一大工业国，不说廉价原料吧，制造业需要稳定供应和价格稳定的原料，这在经济上的不确定性大幅增加，而且这将成为我们在小岛问题硬碰硬的时候的一个巨大顾虑\\x3c/span\\x3e\\x3c/span\\x3e\\x3c/section\\x3e\\x3csection data-mpa-action-id=\\x22mmdc9lwi1jgn\\x22\\x3e\\x3cspan style=\\x22font-size: 21.3333px;\\x22\\x3e\\x3cspan leaf=\\x22\\x22\\x3e\\x3cspan textstyle=\\x22\\x22 style=\\x22font-weight: bold;\\x22\\x3e反制\\x3c/span\\x3e\\x3c/span\\x3e\\x3c/span\\x3e\\x3c/section\\x3e\\x3csection data-mpa-action-id=\\x22mmdc9lwidbt\\x22\\x3e\\x3cspan style=\\x22font-size: 14.6667px;\\x22\\x3e\\x3cspan leaf=\\x22\\x22\\x3e巫师既然想到了这一点，国家肯定也想到了，那怎么办呢，我们目前有巨量的原油战略储备，甲醇港口库存145万吨处于历史高位，暂时还是有很大安全冗余\\x3c/span\\x3e\\x3c/span\\x3e\\x3c/section\\x3e\\x3csection data-mpa-action-id=\\x22mmdc9lwiako\\x22\\x3e\\x3cspan style=\\x22font-size: 14.6667px;\\x22\\x3e\\x3csection style=\\x22display: inline-block;text-indent: 0px;\\x22 nodeleaf=\\x22\\x22\\x3e\\x3cimg class=\\x22rich_pages wxw-img\\x22 data-aistatus=\\x221\\x22 data-backh=\\x22324\\x22 data-backw=\\x22577\\x22 data-imgfileid=\\x22100002984\\x22 data-ratio=\\x221\\x22 data-src=\\x22https://mmbiz.qpic.cn/mmbiz_jpg/hmkxKic9qKJHzJrFH6R7fLh3QVCJcVDTfj6KQUZM7rCz4hT6EmjQS0y1Ihf7t44LVJuNhAMfTibsSJNYRiazNWsj6Tcott6HkjjZjOjt6uQE3I/640?wx_fmt=other\\x26amp;from=appmsg\\x22 data-type=\\x22webp\\x22 data-w=\\x221000\\x22 style=\\x22left:0px;top:0px;width:100%;background-color:transparent;\\x22\\x3e\\x3c/section\\x3e\\x3c/span\\x3e\\x3c/section\\x3e\\x3csection data-mpa-action-id=\\x22mmdc9lwifc7\\x22\\x3e\\x3cspan style=\\x22font-size: 14.6667px;\\x22\\x3e\\x3cspan leaf=\\x22\\x22\\x3e而且国内甲醇产能虽然成本高但技术成熟。而且我们手里也有反制牌——稀土、关键矿产、供应链，大豆和波音订单，美国同样有有求于中国的环节\\x3c/span\\x3e\\x3c/span\\x3e\\x3c/section\\x3e\\x3csection data-mpa-action-id=\\x22mmdc9lwi1665\\x22\\x3e\\x3cspan style=\\x22font-size: 14.6667px;\\x22\\x3e\\x3cspan leaf=\\x22\\x22\\x3e再进一步，对手绝不是全知全能的理性行为体，他们内部就算有这个计划，也执行不了几步，都是草台班子，虽然委内瑞拉、伊朗和霍尔木兹已经实现了，但后面不一定\\x3c/span\\x3e\\x3c/span\\x3e\\x3c/section\\x3e\\x3csection data-mpa-action-id=\\x22mmdc9lwi1ro0\\x22\\x3e\\x3cspan style=\\x22font-size: 14.6667px;\\x22\\x3e\\x3cspan leaf=\\x22\\x22\\x3e但我们比较难受在于，这一套战争附加余波的阴招，它不需要走到最后一步就已经在生效\\x3c/span\\x3e\\x3c/span\\x3e\\x3c/section\\x3e\\x3csection data-mpa-action-id=\\x22mmdc9lwi9lv\\x22\\x3e\\x3cspan style=\\x22font-size: 14.6667px;\\x22\\x3e\\x3cspan leaf=\\x22\\x22\\x3e因为防守方的成本永远高于进攻方。每年进口42亿桶原油，每桶成本上升10美元就是420亿美元的额外支出。光是把原油从70美元推到90-100美元，把甲醇从2500涨到3500，把航运保险费率翻一倍，我国制造业的最重要的群体，也就是中国经济的最精英的生力军，就已经很难受了\\x3c/span\\x3e\\x3c/span\\x3e\\x3c/section\\x3e\\x3csection data-mpa-action-id=\\x22mmdc9lwi2377\\x22\\x3e\\x3cspan style=\\x22font-size: 14.6667px;\\x22\\x3e\\x3cspan leaf=\\x22\\x22\\x3e事实上，我们当然可以通过上期提到的SPR也就是战略石油储备操作来缓解，\\x3c/span\\x3e\\x3c/span\\x3e\\x3c/section\\x3e\\x3csection data-mpa-action-id=\\x22mmdc9lwi1bb3\\x22\\x3e\\x3cspan style=\\x22font-size: 14.6667px;\\x22\\x3e\\x3csection style=\\x22display: inline-block;text-indent: 0px;\\x22 nodeleaf=\\x22\\x22\\x3e\\x3cimg class=\\x22rich_pages wxw-img\\x22 data-aistatus=\\x221\\x22 data-backh=\\x22324\\x22 data-backw=\\x22577\\x22 data-imgfileid=\\x22100002987\\x22 data-ratio=\\x221\\x22 data-src=\\x22https://mmbiz.qpic.cn/sz_mmbiz_jpg/hmkxKic9qKJEzsxg9eSVRH0WUt6FnnYtAv4XRxqAZ6PAVEuicVelO6BFMd44M5x6eFNv7VmJZsHYtz0TG8LHNgkibESfufnVhVIR9ZmNhEVgVk/640?wx_fmt=other\\x26amp;from=appmsg\\x22 data-type=\\x22webp\\x22 data-w=\\x221000\\x22 style=\\x22left:0px;top:0px;width:100%;background-color:transparent;\\x22\\x3e\\x3c/section\\x3e\\x3c/span\\x3e\\x3c/section\\x3e\\x3csection data-mpa-action-id=\\x22mmdc9lwi1w3a\\x22\\x3e\\x3cspan style=\\x22font-size: 14.6667px;\\x22\\x3e\\x3cspan leaf=\\x22\\x22\\x3e也包括政府和企业部门在大宗资本市场上进行操作，甚至包括更隐蔽的手段来增加自己的安全垫，但都附带相应的成本，金融市场和大宗市场的操作其实处于表面层\\x3c/span\\x3e\\x3c/span\\x3e\\x3c/section\\x3e\\x3csection data-mpa-action-id=\\x22mmdc9lwi2u\\x22\\x3e\\x3cspan style=\\x22font-size: 14.6667px;\\x22\\x3e\\x3cspan leaf=\\x22\\x22\\x3e还是巫师的爆论，很多人觉得太极端了，但我一直觉得说什么经济金融，最底层还是军事实力，要我说，咱们的船还是太少了，海空军还是太小了，必须把我们的实力投射到这些关键卡脖子的运输要道，在那些海峡，港口我们也能开过去，为全球贸易航路的稳定，为全人类的发展，发挥定海神针的效用，顺带着，嘿嘿，保护我们自己的利益，但这是巫师的最“中”幻想了，我们先努努力冲出第一岛链再说，但我这个思路绝对是【治本】的思路\\x3c/span\\x3e\\x3c/span\\x3e\\x3c/section\\x3e\\x3csection data-mpa-action-id=\\x22mmdc9lwi139i\\x22\\x3e\\x3cspan style=\\x22font-size: 14.6667px;\\x22\\x3e\\x3cspan leaf=\\x22\\x22\\x3e关于军工体系，可以去看我军贸分析和拆解军工这两期，拆解军工那期太惨了，认认真真弄了一个月，结果没人看\\x3c/span\\x3e\\x3c/span\\x3e\\x3c/section\\x3e\\x3csection data-mpa-action-id=\\x22mmdc9lwi1j3h\\x22\\x3e\\x3cspan style=\\x22font-size: 14.6667px;\\x22\\x3e\\x3csection style=\\x22display: inline-block;text-indent: 0px;\\x22 nodeleaf=\\x22\\x22\\x3e\\x3cimg class=\\x22rich_pages wxw-img\\x22 data-aistatus=\\x221\\x22 data-backh=\\x22358\\x22 data-backw=\\x22578\\x22 data-imgfileid=\\x22100002983\\x22 data-ratio=\\x221\\x22 data-src=\\x22https://mmbiz.qpic.cn/mmbiz_jpg/hmkxKic9qKJHaIFbOk1DYnJO6to5qmV95X1fphuiaQtDibLEjfeib3aO7PnhnlibP4Bq2HmFrWZys7j5dy8Foh1rWNgq3XkhjNCeVqRIT9FAmxg4/640?wx_fmt=other\\x26amp;from=appmsg\\x22 data-type=\\x22webp\\x22 data-w=\\x22823\\x22 style=\\x22left:0px;top:0px;width:100%;background-color:transparent;\\x22\\x3e\\x3c/section\\x3e\\x3c/span\\x3e\\x3c/section\\x3e\\x3csection data-mpa-action-id=\\x22mmdc9lwi4p7\\x22\\x3e\\x3cspan style=\\x22font-size: 14.6667px;\\x22\\x3e\\x3csection style=\\x22display: inline-block;text-indent: 0px;\\x22 nodeleaf=\\x22\\x22\\x3e\\x3cimg class=\\x22rich_pages wxw-img\\x22 data-aistatus=\\x221\\x22 data-backh=\\x22302\\x22 data-backw=\\x22578\\x22 data-imgfileid=\\x22100002986\\x22 data-ratio=\\x221\\x22 data-src=\\x22https://mmbiz.qpic.cn/sz_mmbiz_jpg/hmkxKic9qKJErxjxjoGSqtVvQib1WnXC2XnpgJEbfkZ2vlrlI6PTibA75rCrSib8oFCR2xLQGUb6k9zGRFHlNyhfUSmiaErU4mhAS65W5gHIXpsc/640?wx_fmt=other\\x26amp;from=appmsg\\x22 data-type=\\x22webp\\x22 data-w=\\x221000\\x22 style=\\x22left:0px;top:0px;width:100%;background-color:transparent;\\x22\\x3e\\x3c/section\\x3e\\x3c/span\\x3e\\x3c/section\\x3e\\x3csectio